import hashlib, os, subprocess, sys

def run(*a):
    r = subprocess.run(a, capture_output=True)
    if r.returncode:
        sys.stderr.write("CMD FAILED: %s\n%s" % (a, r.stderr.decode('utf-8', 'replace')))
        sys.exit(1)
    return r.stdout

