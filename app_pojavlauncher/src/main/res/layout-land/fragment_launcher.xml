<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR LAUNCHER — reference-style home (top bar / hero cards / bottom launch bar / glass slide-out) -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:animateLayoutChanges="true"
    android:background="@drawable/premium_gradient_bg">

    <!-- Unified Dynamic Background Animation Layer -->
    <com.kdt.mcgui.BackgroundAnimationView
        android:id="@+id/background_animation_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ============ TOP BAR (glass chip bar) ============ -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_10sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/hamburger_menu_icon"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:src="@drawable/ic_hamburger"
            android:background="@drawable/home_icon_chip_bg"
            android:padding="@dimen/_7sdp"
            app:tint="#FF003C"
            android:layout_marginEnd="@dimen/_10sdp" />

        <ImageView
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:src="@drawable/ic_app_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="FEAR LAUNCHER"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:layout_marginStart="@dimen/_8sdp" />

        <ImageButton
            android:id="@+id/header_account_hub_btn"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/ic_account_circle"
            android:background="@drawable/home_icon_chip_bg"
            android:padding="@dimen/_6sdp"
            app:tint="#FF003C"
            android:layout_marginEnd="@dimen/_8sdp" />

        <ImageButton
            android:id="@+id/header_notification_btn"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/ic_px_bell"
            android:background="@drawable/home_icon_chip_bg"
            android:padding="@dimen/_6sdp"
            app:tint="#FF003C"
            android:layout_marginEnd="@dimen/_8sdp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/header_avatar_card"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            app:cardCornerRadius="@dimen/_15sdp"
            app:cardBackgroundColor="#20FFFFFF"
            app:cardElevation="0dp"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_account_circle"
                android:padding="0dp" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- ============ MAIN CONTENT (hero cards) ============ -->
    <LinearLayout
        android:id="@+id/home_content_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingBottom="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toTopOf="@+id/bottom_launch_bar">

        <!-- HERO PLAYER CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/home_hero_card_bg"
            android:padding="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_10sdp">

            <!-- Left: identity column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAYER CARD"
                    android:textColor="#FF003C"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"
                    android:layout_marginBottom="@dimen/_4sdp" />

                <TextView
                    android:id="@+id/account_name_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guest"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_18ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/version_text_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.21.1"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_8sdp">

                    <TextView
                        android:id="@+id/card_runtime_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JVM: INTERNAL"
                        android:textColor="#42FF42"
                        android:textSize="@dimen/_7ssp"
                        android:textStyle="bold"
                        android:background="#2042FF42"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/card_loader_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOADER: AUTO"
                        android:textColor="#FF003C"
                        android:textSize="@dimen/_7ssp"
                        android:textStyle="bold"
                        android:background="#20FF003C"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <!-- Live status feed strip -->
                <TextView
                    android:id="@+id/homepage_chat_bubble"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/premium_glass_black_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp"
                    android:textAlignment="center"
                    android:fontFamily="monospace"
                    android:text="[SYSTEM] Boot sequence ready."
                    android:layout_marginTop="@dimen/_14sdp" />
            </LinearLayout>

            <!-- Right: skin viewer column -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="@dimen/_14sdp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/home_icon_chip_bg"
                    android:padding="@dimen/_10sdp">

                    <com.kdt.mcgui.MinecraftSkinView
                        android:id="@+id/homepage_skin_head"
                        android:layout_width="130dp"
                        android:layout_height="110dp" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE SKIN"
                    android:textColor="#59FFFFFF"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginTop="@dimen/_6sdp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============ BOTTOM LAUNCH BAR (reference-style) ============ -->
    <LinearLayout
        android:id="@+id/bottom_launch_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/home_bottom_bar_bg"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingVertical="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/edit_profile_button_main"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:src="@drawable/ic_px_edit"
            android:background="@drawable/home_icon_chip_bg"
            android:padding="@dimen/_8sdp"
            app:tint="#FF003C"
            android:layout_marginEnd="@dimen/_8sdp" />

        <ImageButton
            android:id="@+id/settings_button_main"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:src="@drawable/ic_sharp_settings_24"
            android:background="@drawable/home_icon_chip_bg"
            android:padding="@dimen/_8sdp"
            app:tint="#FF003C"
            android:layout_marginEnd="@dimen/_12sdp" />

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="0dp"
            android:layout_height="@dimen/_36sdp"
            android:layout_weight="1"
            android:background="@drawable/premium_glass_black_bg" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="150dp"
            android:layout_height="@dimen/_42sdp"
            android:text="LAUNCH"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:background="@drawable/premium_play_button_bg"
            android:layout_marginStart="@dimen/_12sdp" />
    </LinearLayout>

    <!-- UI Logic Dummies -->
    <TextView android:id="@+id/account_name" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/account_type_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/version_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/account_section" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/edit_profile_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_home" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_installations" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_skin" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_settings_icon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <!-- ============ HAMBURGER SLIDE-OUT PANEL (glass, rounded right, animated) ============ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settings_tray"
        android:layout_width="274dp"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:cardBackgroundColor="#F2050508"
        app:cardCornerRadius="26dp"
        app:cardElevation="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tray_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_14sdp"
                android:background="@drawable/tray_panel_bg">

                <!-- Panel header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardCornerRadius="21dp"
                        app:cardBackgroundColor="#20FFFFFF"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_app_logo"
                            android:scaleType="centerCrop"
                            android:padding="7dp" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FEAR CONTROL"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SYSTEMS ONLINE"
                            android:textColor="#FF003C"
                            android:textSize="@dimen/_7ssp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 1: OPERATIONS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OPERATIONS"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_logs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="EXPORT LOGS"
                    android:drawableStart="@drawable/ic_px_sharelog"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <net.kdt.pojavlauncher.recorder.RecorderMenuButton
                    android:id="@+id/tray_recorder_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="SCREEN RECORDER"
                    android:drawableStart="@drawable/ic_rec_video"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_downloads_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="BACKGROUND DOWNLOADS"
                    android:drawableStart="@drawable/ic_px_file_dl"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_news_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="LATEST NEWS"
                    android:drawableStart="@drawable/ic_px_book"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="12dp" />

                <!-- SECTION 2: LIBRARY -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LIBRARY"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_mods_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="INSTALLED MODS"
                    android:drawableStart="@drawable/ic_px_zap"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_resource_packs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="RESOURCE PACKS"
                    android:drawableStart="@drawable/ic_px_image"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_shader_packs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="SHADER PACKS"
                    android:drawableStart="@drawable/ic_px_image_renderer"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_skin_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="SKIN CUSTOMIZER"
                    android:drawableStart="@drawable/ic_account_circle"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="12dp" />

                <!-- SECTION 3: SYSTEM -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_controls_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="DEVELOPER OPTIONS"
                    android:drawableStart="@drawable/ic_px_gamepad"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_settings_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="EXPERIMENTAL STUFF"
                    android:drawableStart="@drawable/ic_px_sliders"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_info_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="INFO + CREATORS"
                    android:drawableStart="@drawable/ic_px_experiment"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="16dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/tray_close"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="CLOSE PANEL"
                    android:textColor="#000000"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_button_bg" />
            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <!-- Minecraft Advancement Made Toast Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/advancement_toast_layout"
        android:layout_width="@dimen/_180sdp"
        android:layout_height="wrap_content"
        android:background="@drawable/minecraft_advancement_bg"
        android:padding="@dimen/_8sdp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp">

        <ImageView
            android:id="@+id/advancement_icon"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:src="@drawable/ic_youtube_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_8sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/advancement_icon"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Advancement Made!"
                android:textColor="#FFFF55"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/advancement_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subscribe to twicefear"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
