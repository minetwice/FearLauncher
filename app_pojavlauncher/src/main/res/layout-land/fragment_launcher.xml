<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR LAUNCHER - GIGACAT-style fresh home -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#00000000">

    <!-- looping clip behind the UI -->
    <com.kdt.mcgui.LoopingVideoBackground
        android:id="@+id/background_animation_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- scrim so the interface stays readable over the clip -->
    <View
        android:id="@+id/bg_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <!-- colour wash that follows the clip's red/blue cycle -->
    <View
        android:id="@+id/color_wash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00FF2B3A" />

    <ImageButton
        android:id="@+id/ui_toggle_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_eye"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:padding="6dp"
        android:elevation="18dp"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="@dimen/_10sdp" />

    <!-- == TOP BAR == -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/hamburger_menu_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_menu_orange"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:layout_marginEnd="10dp" />

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/premium_glass_black_bg"
            android:padding="5dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_app_logo"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="FEAR LAUNCHER"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginStart="10dp" />

        <!-- kept for the fragment's bindings, no longer shown -->
        <ImageButton android:id="@+id/social_discord_btn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageButton android:id="@+id/social_youtube_btn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageButton android:id="@+id/header_notification_btn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <FrameLayout android:id="@+id/header_avatar_card" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageButton android:id="@+id/header_account_hub_btn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </LinearLayout>

    <!-- == HOME == -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/landscape_dashboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ids the fragment still binds - kept, hidden for a clean screen -->
        <TextView android:id="@+id/version_text_display" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <TextView android:id="@+id/card_runtime_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <TextView android:id="@+id/card_loader_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <TextView android:id="@+id/account_name_display" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <TextView android:id="@+id/homepage_chat_bubble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <ImageButton android:id="@+id/settings_button_main" android:layout_width="42dp" android:layout_height="42dp" android:visibility="gone" />
        <ImageButton android:id="@+id/edit_profile_button_main" android:layout_width="52dp" android:layout_height="52dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/homepage_instance_carousel" android:layout_width="wrap_content" android:layout_height="0dp" android:visibility="gone" android:orientation="horizontal" />

        <!-- controls: dead centre of the screen -->
        <LinearLayout
            android:id="@+id/home_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="250dp"
                android:layout_height="46dp"
                android:background="@drawable/premium_glass_black_bg"
                android:elevation="12dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/play_button"
                android:layout_width="220dp"
                android:layout_height="62dp"
                android:layout_marginTop="@dimen/_12sdp"
                android:elevation="0dp"
                android:text="PLAY"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />


        </LinearLayout>

        <!-- character: right side, vertically centred -->
        <com.kdt.mcgui.MinecraftSkinView
            android:id="@+id/homepage_skin_body"
            android:layout_width="200dp"
            android:layout_height="260dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/home_controls"
            android:layout_marginStart="@dimen/_20sdp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- UI Logic Dummies -->
    <TextView android:id="@+id/account_name" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/account_type_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/version_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/account_section" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/edit_profile_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_home" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_installations" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_skin" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_settings_icon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <!-- ULTRA-PROFESSIONAL GLASS SIDEBAR TRAY (Slides from Left - Overhauled perfect dimensions) -->
        <!-- ===== SIDE PANEL (transparent shell, floating glass rows) ===== -->
    <FrameLayout
        android:id="@+id/settings_tray"
        android:layout_width="252dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@null"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toBottomOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/tray_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_6sdp"
                    android:layout_marginBottom="@dimen/_8sdp">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:src="@drawable/ic_fear_diamond"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="FEAR LAUNCHER"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold"
                        android:letterSpacing="0.14"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginStart="@dimen/_10sdp" />
                </LinearLayout>

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_installations_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_46sdp"
                    android:text="INSTALLATIONS"
                    android:drawableStart="@drawable/ic_px_home"
                    android:drawableTint="#FFFFFF"
                    android:background="@null"
                    android:elevation="@dimen/_6sdp"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="@dimen/_8sdp" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_jar_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_46sdp"
                    android:text="EXECUTE A JAR"
                    android:drawableStart="@drawable/ic_px_java_run"
                    android:drawableTint="#FFFFFF"
                    android:background="@null"
                    android:elevation="@dimen/_6sdp"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="@dimen/_8sdp" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_controls_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_46sdp"
                    android:text="CUSTOM CONTROLS"
                    android:drawableStart="@drawable/ic_px_gamepad"
                    android:drawableTint="#FFFFFF"
                    android:background="@null"
                    android:elevation="@dimen/_6sdp"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="@dimen/_8sdp" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_manager_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_46sdp"
                    android:text="MANAGER"
                    android:drawableStart="@drawable/ic_px_runtime_mgr"
                    android:drawableTint="#FFFFFF"
                    android:background="@null"
                    android:elevation="@dimen/_6sdp"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="@dimen/_8sdp" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_more_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_46sdp"
                    android:text="MORE OPTIONS"
                    android:drawableStart="@drawable/ic_px_gear"
                    android:drawableTint="#FFFFFF"
                    android:background="@null"
                    android:elevation="@dimen/_6sdp"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="@dimen/_8sdp" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_logs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_46sdp"
                    android:text="EXPORT LOGS"
                    android:drawableStart="@drawable/ic_px_sharelog"
                    android:drawableTint="#FFFFFF"
                    android:background="@null"
                    android:elevation="@dimen/_6sdp"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="@dimen/_8sdp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Minecraft Advancement Made Toast Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/advancement_toast_layout"
        android:layout_width="@dimen/_180sdp"
        android:layout_height="wrap_content"
        android:background="@drawable/minecraft_advancement_bg"
        android:padding="@dimen/_8sdp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp">

        <ImageView
            android:id="@+id/advancement_icon"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:src="@drawable/ic_youtube_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_8sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/advancement_icon"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Advancement Made!"
                android:textColor="#FFFF55"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/advancement_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subscribe to twicefear"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
