<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR LAUNCHER - GIGACAT-style fresh home -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#00000000">

    <!-- looping clip behind the UI -->
    <com.kdt.mcgui.LoopingVideoBackground
        android:id="@+id/background_animation_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- scrim so the interface stays readable over the clip -->
    <View
        android:id="@+id/bg_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <!-- colour wash that follows the clip's red/blue cycle -->
    <View
        android:id="@+id/color_wash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00FF2B3A" />

    <ImageButton
        android:id="@+id/ui_toggle_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_eye"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:padding="6dp"
        android:elevation="18dp"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="@dimen/_10sdp" />

    <!-- == TOP BAR == -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/hamburger_menu_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_hamburger"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            app:tint="#FFFFFF"
            android:layout_marginEnd="10dp" />

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/premium_glass_black_bg"
            android:padding="5dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_app_logo"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="FEAR LAUNCHER"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginStart="10dp" />

        <!-- kept for the fragment's bindings, no longer shown -->
        <ImageButton android:id="@+id/social_discord_btn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageButton android:id="@+id/social_youtube_btn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageButton android:id="@+id/header_notification_btn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <FrameLayout android:id="@+id/header_avatar_card" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageButton android:id="@+id/header_account_hub_btn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </LinearLayout>

    <!-- == HOME == -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/landscape_dashboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@id/settings_tray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ids the fragment still binds - kept, hidden for a clean screen -->
        <TextView android:id="@+id/version_text_display" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <TextView android:id="@+id/card_runtime_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <TextView android:id="@+id/card_loader_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <TextView android:id="@+id/account_name_display" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <TextView android:id="@+id/homepage_chat_bubble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <ImageButton android:id="@+id/settings_button_main" android:layout_width="42dp" android:layout_height="42dp" android:visibility="gone" />
        <ImageButton android:id="@+id/edit_profile_button_main" android:layout_width="52dp" android:layout_height="52dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/homepage_instance_carousel" android:layout_width="wrap_content" android:layout_height="0dp" android:visibility="gone" android:orientation="horizontal" />

        <!-- controls: dead centre of the screen -->
        <LinearLayout
            android:id="@+id/home_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="250dp"
                android:layout_height="46dp"
                android:background="@drawable/premium_glass_black_bg"
                android:elevation="12dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/play_button"
                android:layout_width="220dp"
                android:layout_height="62dp"
                android:layout_marginTop="@dimen/_12sdp"
                android:elevation="0dp"
                android:text="PLAY"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />

            <!-- FEAR download bar: percentage + MB readout above, the keyed clip below -->
            <LinearLayout
                android:id="@+id/fear_dl_wrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="@dimen/_10sdp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/fear_dl_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#FFFFD9A0"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="@dimen/_2sdp" />

                <com.kdt.mcgui.FearBarView
                    android:id="@+id/fear_dl_bar"
                    android:layout_width="320dp"
                    android:layout_height="65dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- character: right side, vertically centred -->
        <com.kdt.mcgui.MinecraftSkinView
            android:id="@+id/homepage_skin_body"
            android:layout_width="200dp"
            android:layout_height="260dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/home_controls"
            android:layout_marginStart="@dimen/_20sdp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- UI Logic Dummies -->
    <TextView android:id="@+id/account_name" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/account_type_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/version_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/account_section" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/edit_profile_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_home" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_installations" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_skin" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_settings_icon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <!-- ULTRA-PROFESSIONAL GLASS SIDEBAR TRAY (Slides from Left - Overhauled perfect dimensions) -->
    <FrameLayout
        android:id="@+id/settings_tray"
        android:layout_width="230dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@drawable/premium_glass_black_bg"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toBottomOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tray_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_14sdp"
                android:background="@drawable/premium_glass_black_bg">

                <!-- Premium Header Profile Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/theme_button_bg"
                    android:padding="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#20FFFFFF"
                        app:cardElevation="2dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_app_logo"
                            android:scaleType="centerCrop"
                            android:padding="6dp" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="COMMAND CORE"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SYSTEMS ONLINE"
                            android:textColor="#FF2B3A"
                            android:textSize="@dimen/_7ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 1: OPERATIONS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• OPERATIONS &amp; DIAGNOSTICS"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_logs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="EXPORT LOGS"
                    android:drawableStart="@drawable/ic_px_sharelog"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_news_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="LATEST NEWS"
                    android:drawableStart="@drawable/ic_px_book"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="12dp" />

                <!-- SECTION 2: INSTALLED ADDONS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• INSTALLED MODULES"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_mods_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="INSTALLED MODS"
                    android:drawableStart="@drawable/ic_px_zap"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_resource_packs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="RESOURCE PACKS"
                    android:drawableStart="@drawable/ic_px_image"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_shader_packs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="SHADER PACKS"
                    android:drawableStart="@drawable/ic_px_image_renderer"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                                <!-- SECTION 3: SYSTEM CONTROLS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• DEV &amp; COMMAND EXPERIMENT"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_controls_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="DEVELOPER OPTIONS"
                    android:drawableStart="@drawable/ic_px_gamepad"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_settings_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="EXPERIMENTAL STUFF"
                    android:drawableStart="@drawable/ic_px_sliders"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_info_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="INFO &amp; CREATORS"
                    android:drawableStart="@drawable/ic_px_experiment"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="16dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/tray_close"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="COLLAPSE TERMINAL"
                    android:textColor="#000000"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold"
                    android:background="@drawable/theme_button_bg" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Minecraft Advancement Made Toast Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/advancement_toast_layout"
        android:layout_width="@dimen/_180sdp"
        android:layout_height="wrap_content"
        android:background="@drawable/minecraft_advancement_bg"
        android:padding="@dimen/_8sdp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp">

        <ImageView
            android:id="@+id/advancement_icon"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:src="@drawable/ic_youtube_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_8sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/advancement_icon"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Advancement Made!"
                android:textColor="#FFFF55"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/advancement_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subscribe to twicefear"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
