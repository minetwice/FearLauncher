<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg">

    <!-- Settings Gear Menu Trigger (Top Right) -->
    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/hamburger_menu_icon"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_margin="@dimen/_16sdp"
        android:src="@drawable/ic_sharp_settings_24"
        android:background="@drawable/premium_button_bg"
        android:padding="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main Content Area (Landscape Infumia Style) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Info Card (Center) -->
        <LinearLayout
            android:layout_width="@dimen/_300sdp"
            android:layout_height="wrap_content"
            android:background="@drawable/premium_glass_black_bg"
            android:orientation="vertical"
            android:padding="@dimen/_20sdp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:src="@drawable/ic_app_logo"
                android:layout_marginBottom="@dimen/_10sdp" />

            <TextView
                android:id="@+id/account_name_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guest"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/version_text_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.21.1"
                android:textColor="#E0E0E0"
                android:textSize="@dimen/_12ssp"
                android:layout_marginBottom="@dimen/_20sdp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.kdt.mcgui.mcVersionSpinner
                    android:id="@+id/mc_version_spinner"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/premium_glass_black_bg" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/play_button"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:text="PLAY"
                    android:textColor="#000000"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_button_bg" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dummy views for logic -->
        <View android:id="@+id/edit_profile_button_main" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- UI Logic Dummies -->
    <TextView android:id="@+id/account_name" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/account_type_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/version_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/account_section" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/edit_profile_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_home" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_installations" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_skin" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_settings_icon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <!-- ULTRA-PROFESSIONAL GLASS SIDEBAR TRAY (Slides from Right) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settings_tray"
        android:layout_width="@dimen/_240sdp"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:cardBackgroundColor="#F2000000"
        app:cardCornerRadius="0dp"
        app:cardElevation="32dp"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tray_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_16sdp"
                android:background="@drawable/premium_glass_black_bg">

                <!-- Premium Header Profile Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/premium_edit_bg"
                    android:padding="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="24dp"
                        app:cardBackgroundColor="#20FFFFFF"
                        app:cardElevation="2dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_app_logo"
                            android:scaleType="centerCrop"
                            android:padding="6dp" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="COMMAND CORE"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STABILITY: ONLINE"
                            android:textColor="#00FFCC"
                            android:textSize="@dimen/_7ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 1: CORE OPERATIONS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• CORE OPERATIONS"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_settings_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:text="SETTINGS ENGINE"
                    android:drawableStart="@drawable/ic_px_sliders"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="8dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_execute_jar_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:text="RUN EXECUTABLE"
                    android:drawableStart="@drawable/ic_px_java_run"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="16dp" />

                <!-- SECTION 2: PERSONALIZATION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• PERSONALIZATION"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_skin_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:text="SKIN CUSTOMIZER"
                    android:drawableStart="@drawable/ic_account_circle"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="8dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_account_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:text="ACCOUNT HUB"
                    android:drawableStart="@drawable/ic_px_edit"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="16dp" />

                <!-- SECTION 3: EXPANSIONS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• UTILITY MODULES"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/more_settings_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:text="ADVANCED TOOLS"
                    android:drawableStart="@drawable/ic_px_alt_sliders"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="8dp" />

                <!-- Sub Tray for More Settings -->
                <LinearLayout
                    android:id="@+id/more_settings_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp"
                    android:paddingStart="8dp">

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/tray_controls_btn"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_36sdp"
                        android:text="INPUT MAPPING"
                        android:textSize="@dimen/_9ssp"
                        android:background="@drawable/tray_button_bg"
                        android:layout_marginBottom="4dp" />

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/tray_mods_btn"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_36sdp"
                        android:text="MODIFICATIONS"
                        android:textSize="@dimen/_9ssp"
                        android:background="@drawable/tray_button_bg"
                        android:layout_marginBottom="4dp" />

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/tray_logs_btn"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_36sdp"
                        android:text="DATA STREAM"
                        android:textSize="@dimen/_9ssp"
                        android:background="@drawable/tray_button_bg"
                        android:layout_marginBottom="4dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/tray_close"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="COLLAPSE TERMINAL"
                    android:textColor="#000000"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_button_bg" />
            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
