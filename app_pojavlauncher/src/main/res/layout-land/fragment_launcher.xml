<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR LAUNCHER - GIGACAT-style fresh home -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#00000000">

    <!-- looping clip behind the UI -->
    <com.kdt.mcgui.LoopingVideoBackground
        android:id="@+id/background_animation_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- scrim so the interface stays readable over the clip -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <!-- colour wash that follows the clip's red/blue cycle -->
    <View
        android:id="@+id/color_wash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00FF2B3A" />

    <!-- == TOP BAR == -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/premium_glass_black_bg"
            android:padding="5dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_app_logo"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="FEAR LAUNCHER"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginStart="10dp" />

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/premium_glass_black_bg"
            android:layout_marginEnd="10dp">
            <ImageButton
                android:id="@+id/social_discord_btn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_discord"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="5dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/premium_glass_black_bg"
            android:layout_marginEnd="10dp">
            <ImageButton
                android:id="@+id/social_youtube_btn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_youtube_logo"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/header_notification_btn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_px_bell"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FF2B3A"
            android:layout_marginEnd="12dp" />

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/header_avatar_card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="21dp"
                app:cardBackgroundColor="#3313162C"
                app:cardElevation="0dp">
                <com.kdt.mcgui.MinecraftSkinView
                    android:id="@+id/homepage_skin_head"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.cardview.widget.CardView>
            <ImageButton
                android:id="@+id/header_account_hub_btn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:contentDescription="@null" />
        </FrameLayout>

    </LinearLayout>

    <!-- == LANDSCAPE DASHBOARD == -->
    <!-- Wide phones waste the vertical portrait stack, so the home screen is
         laid out as two columns here: the hero card (version + PLAY) on the
         left, the instance carousel on the right. -->
    <LinearLayout
        android:id="@+id/landscape_dashboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingBottom="@dimen/_8sdp"
        app:layout_constraintStart_toEndOf="@id/settings_tray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- LEFT: just the launch bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/premium_glass_black_bg"
            android:elevation="10dp"
            android:padding="@dimen/_16sdp">

            <!-- ids the fragment still binds - kept, hidden for a clean screen -->
            <TextView android:id="@+id/version_text_display" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/card_runtime_info" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/card_loader_info" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/account_name_display" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/homepage_chat_bubble" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone" />
            <ImageButton android:id="@+id/settings_button_main" android:layout_width="42dp"
                android:layout_height="42dp" android:visibility="gone" />
            <ImageButton android:id="@+id/edit_profile_button_main" android:layout_width="52dp"
                android:layout_height="52dp" android:visibility="gone" />

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/premium_glass_black_bg" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/play_button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/_14sdp"
                android:text="PLAY"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:background="@drawable/play_btn_cycle" />
        </LinearLayout>

        <!-- RIGHT: the character, standing beside the launch bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="@dimen/_12sdp">

            <com.kdt.mcgui.MinecraftSkinView
                android:id="@+id/homepage_skin_body"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_gravity="center"
                android:background="@drawable/premium_glass_black_bg"
                android:elevation="10dp" />

            <LinearLayout
                android:id="@+id/homepage_instance_carousel"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:visibility="gone"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>

    <!-- UI Logic Dummies -->
    <TextView android:id="@+id/account_name" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/account_type_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/version_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/account_section" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/edit_profile_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_home" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_installations" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_skin" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_settings_icon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <include layout="@layout/splash_overlay_layout" />

    <!-- ULTRA-PROFESSIONAL GLASS SIDEBAR TRAY (Slides from Left - Overhauled perfect dimensions) -->
    <FrameLayout
        android:id="@+id/settings_tray"
        android:layout_width="230dp"
        android:layout_height="0dp"
        android:visibility="visible"
        android:background="@drawable/premium_glass_black_bg"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toBottomOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tray_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_14sdp"
                android:background="@drawable/premium_glass_black_bg">

                <!-- Premium Header Profile Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/theme_button_bg"
                    android:padding="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#20FFFFFF"
                        app:cardElevation="2dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_app_logo"
                            android:scaleType="centerCrop"
                            android:padding="6dp" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="COMMAND CORE"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SYSTEMS ONLINE"
                            android:textColor="#FF2B3A"
                            android:textSize="@dimen/_7ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 1: OPERATIONS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• OPERATIONS &amp; DIAGNOSTICS"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_logs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="EXPORT LOGS"
                    android:drawableStart="@drawable/ic_px_sharelog"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_downloads_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="BACKGROUND DOWNLOADS"
                    android:drawableStart="@drawable/ic_download"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_news_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="LATEST NEWS"
                    android:drawableStart="@drawable/ic_px_book"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="12dp" />

                <!-- SECTION 2: INSTALLED ADDONS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• INSTALLED MODULES"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_mods_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="INSTALLED MODS"
                    android:drawableStart="@drawable/ic_px_zap"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_resource_packs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="RESOURCE PACKS"
                    android:drawableStart="@drawable/ic_px_image"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_shader_packs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="SHADER PACKS"
                    android:drawableStart="@drawable/ic_px_image_renderer"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                                <!-- SECTION 3: SYSTEM CONTROLS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• DEV &amp; COMMAND EXPERIMENT"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_controls_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="DEVELOPER OPTIONS"
                    android:drawableStart="@drawable/ic_px_gamepad"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_settings_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="EXPERIMENTAL STUFF"
                    android:drawableStart="@drawable/ic_px_sliders"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_info_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="INFO &amp; CREATORS"
                    android:drawableStart="@drawable/ic_px_experiment"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="16dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/tray_close"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="COLLAPSE TERMINAL"
                    android:textColor="#000000"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold"
                    android:background="@drawable/theme_button_bg" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>w>

    <!-- Minecraft Advancement Made Toast Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/advancement_toast_layout"
        android:layout_width="@dimen/_180sdp"
        android:layout_height="wrap_content"
        android:background="@drawable/minecraft_advancement_bg"
        android:padding="@dimen/_8sdp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp">

        <ImageView
            android:id="@+id/advancement_icon"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:src="@drawable/ic_youtube_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_8sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/advancement_icon"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Advancement Made!"
                android:textColor="#FFFF55"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/advancement_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subscribe to twicefear"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
