<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Main Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/premium_gradient_bg">

        <!-- Fragment Container -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/container_fragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />


    </LinearLayout>

        <!-- global red/blue wash: sits over every screen so the accent cycle is
             identical everywhere instead of per-screen -->
        <View
            android:id="@+id/fear_global_wash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:background="#00FF2B3A" />


        <!-- FEAR download bar: topmost layer, so it shows over EVERY screen
             whenever anything is downloading -->
        <LinearLayout
            android:id="@+id/fear_dl_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/_10sdp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:elevation="40dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/fear_dl_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#FFFFD9A0"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <com.kdt.mcgui.FearBarView
                android:id="@+id/fear_dl_bar"
                android:layout_width="330dp"
                android:layout_height="60dp" />
        </LinearLayout>
    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>
