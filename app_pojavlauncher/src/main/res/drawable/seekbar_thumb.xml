<?xml version="1.0" encoding="utf-8"?>
<!-- memory slider handle: a white-hot core inside a red aura, like the reference -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="44dp" android:height="44dp" />
            <gradient android:type="radial" android:gradientRadius="22dp"
                android:startColor="#99FFF3F6"
                android:centerColor="#55FF2B3A"
                android:endColor="#00FF2B3A" />
        </shape>
    </item>
    <item android:top="14dp" android:bottom="14dp" android:left="14dp" android:right="14dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="9dp"
                android:startColor="#FFFFFFFF"
                android:centerColor="#FFFFE9EE"
                android:endColor="#FFFF7A8C" />
        </shape>
    </item>
</layer-list>
