<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FF003C"> <!-- Cyber-red premium ripple feedback -->
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <!-- Translucent, dark glass-black background fill -->
            <solid android:color="#EB0F0204" />
            <corners android:radius="8dp" />
            <!-- Glowing Red Theme border stroke -->
            <stroke android:width="1dp" android:color="#33FF003C" />
        </shape>
    </item>
</ripple>
