<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4000F0FF"> <!-- Neon cyber ripple feedback -->

    <!-- Base / normal button outline and background -->
    <item>
        <shape>
            <!-- High-contrast translucent dark glass fill -->
            <solid android:color="#EB050A14" />

            <!-- Modern subtle glowing cyber border stroke -->
            <stroke android:width="1dp" android:color="#334D00F0" />

            <!-- Blocky sleek rounded corners matching premium UI -->
            <corners android:radius="8dp" />
        </shape>
    </item>

</ripple>
