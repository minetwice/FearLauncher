<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR UI v5: tray button glass + soft shadow + ripple (no border) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2EFF4D6D">
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient android:angle="270" android:startColor="#12000000" android:endColor="#4D000000" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient android:angle="90" android:startColor="#B3131621" android:endColor="#960D1018" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
