<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR UI: Lunar-style frosted glass pill for sidebar buttons -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#404D9BFF">
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="14dp" />
                    <solid android:color="#9913162C" />
                    <stroke android:width="1dp" android:color="#264D9BFF" />
                </shape>
            </item>
            <item android:gravity="left" android:width="3dp">
                <shape>
                    <corners android:radius="2dp" />
                    <solid android:color="#664D9BFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
