<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#D0D0D0"
                android:endColor="#FFFFFF"
                android:angle="135" />
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="#909090" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient
                        android:startColor="#FFFFFF"
                        android:endColor="#E6E6E6"
                        android:angle="135" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1.5dp" android:color="#909090" />
                </shape>
            </item>
            <!-- Spike / Shine Line effect inside gradient button -->
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape>
                    <gradient
                        android:angle="45"
                        android:startColor="#00FFFFFF"
                        android:centerColor="#B0C0C0C0"
                        android:endColor="#00FFFFFF"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
