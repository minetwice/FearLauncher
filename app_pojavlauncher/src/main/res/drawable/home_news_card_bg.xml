<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR UI v5: glass info card with soft bottom shadow (no border) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="270" android:startColor="#1A000000" android:endColor="#55000000" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="90" android:startColor="#99131621" android:endColor="#800E1018" />
        </shape>
    </item>
</layer-list>
