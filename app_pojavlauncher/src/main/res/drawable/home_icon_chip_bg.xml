<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR UI v7: low opacity crimson glass chip with soft depth -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:angle="90" android:startColor="#26181020" android:endColor="#1F120A10" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1CDC143C" />
        </shape>
    </item>
</layer-list>
