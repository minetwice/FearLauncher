<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR UI v5: low opacity glass chip with soft depth (no border, no tint) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:angle="90" android:startColor="#70131722" android:endColor="#590A0C12" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#660D0F16" />
        </shape>
    </item>
</layer-list>
