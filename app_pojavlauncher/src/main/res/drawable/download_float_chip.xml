<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR UI v7: floating download icon chip - crimson glass with soft shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="270" android:startColor="#12000000" android:endColor="#66000000" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="90" android:startColor="#B31A0E14" android:endColor="#8C120A10" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#26DC143C" />
        </shape>
    </item>
</layer-list>
