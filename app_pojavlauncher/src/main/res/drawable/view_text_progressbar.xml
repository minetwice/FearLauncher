<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" >

    <!-- Background of the progress bar (translucent dark glass with subtle red border) -->
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/_4sdp" />
            <solid android:color="#F20F0204" />
            <stroke android:width="1dp" android:color="#4DFF003C" />
        </shape>
    </item>

    <!-- The actual animated progress track (glowing crimson to neon cyber-red gradient) -->
    <item android:id="@android:id/progress">
        <clip>
             <shape>
                <corners android:radius="@dimen/_4sdp" />
                <gradient
                    android:startColor="#8E0812"
                    android:endColor="#FF003C"
                    android:angle="0" />
            </shape>
        </clip>
    </item>

</layer-list>
