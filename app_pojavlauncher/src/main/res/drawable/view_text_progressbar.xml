<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" >

    <!-- Background of the progress bar (translucent dark glass with subtle blue border) -->
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/_4sdp" />
            <solid android:color="#F2050A14" />
            <stroke android:width="1dp" android:color="#4D00F0FF" />
        </shape>
    </item>

    <!-- The actual animated progress track (glowing sapphire to neon cyber-blue gradient) -->
    <item android:id="@android:id/progress">
        <clip>
             <shape>
                <corners android:radius="@dimen/_4sdp" />
                <gradient
                    android:startColor="#005BFF"
                    android:endColor="#00F0FF"
                    android:angle="0" />
            </shape>
        </clip>
    </item>

</layer-list>
