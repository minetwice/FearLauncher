<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#80FF003C">
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <layer-list>
                    <!-- Pressed State: Darker Glass and Glowing Border -->
                    <item>
                        <shape>
                            <solid android:color="#F20B0305" />
                            <corners android:radius="10dp" />
                            <stroke android:width="2dp" android:color="#FF003C" />
                        </shape>
                    </item>
                    <!-- Gloss shine overlay -->
                    <item android:top="2dp" android:left="2dp" android:right="2dp">
                        <shape>
                            <gradient
                                android:startColor="#60FFFFFF"
                                android:centerColor="#00FFFFFF"
                                android:endColor="#00FFFFFF"
                                android:angle="270" />
                            <corners android:radius="9dp" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <!-- Base State: Premium Dark Glass background -->
                    <item>
                        <shape>
                            <solid android:color="#E60F0204" />
                            <corners android:radius="10dp" />
                            <stroke android:width="1.5dp" android:color="#4DFF003C" />
                        </shape>
                    </item>
                    <!-- Glass Gloss highlight overlay -->
                    <item android:top="1dp" android:left="1dp" android:right="1dp">
                        <shape>
                            <gradient
                                android:startColor="#30FFFFFF"
                                android:centerColor="#00FFFFFF"
                                android:endColor="#00FFFFFF"
                                android:angle="270" />
                            <corners android:radius="9dp" />
                        </shape>
                    </item>
                    <!-- Elegant horizontal shining line across the button -->
                    <item android:top="6dp" android:bottom="6dp" android:left="2dp" android:right="2dp">
                        <shape>
                            <gradient
                                android:angle="45"
                                android:startColor="#00FFFFFF"
                                android:centerColor="#30FF003C"
                                android:endColor="#00FFFFFF"
                                android:type="linear" />
                        </shape>
                    </item>
                    <item android:top="12dp" android:bottom="12dp" android:left="4dp" android:right="4dp">
                        <shape>
                            <gradient
                                android:angle="45"
                                android:startColor="#00FFFFFF"
                                android:centerColor="#20FFFFFF"
                                android:endColor="#00FFFFFF"
                                android:type="linear" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
