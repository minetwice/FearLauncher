<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#80FF2A2A">
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <layer-list>
                    <item>
                        <shape>
                            <solid android:color="#F20A0000" />
                            <corners android:radius="10dp" />
                            <stroke android:width="2dp" android:color="#FFFF2A2A" />
                        </shape>
                    </item>
                    <item android:top="2dp" android:left="2dp" android:right="2dp">
                        <shape>
                            <gradient
                                android:startColor="#60FFFFFF"
                                android:centerColor="#00FFFFFF"
                                android:endColor="#00FFFFFF"
                                android:angle="270" />
                            <corners android:radius="9dp" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item>
                        <shape>
                            <solid android:color="#E60A0000" />
                            <corners android:radius="10dp" />
                            <stroke android:width="1.5dp" android:color="#4DFF2A2A" />
                        </shape>
                    </item>
                    <item android:top="1dp" android:left="1dp" android:right="1dp">
                        <shape>
                            <gradient
                                android:startColor="#30FFFFFF"
                                android:centerColor="#00FFFFFF"
                                android:endColor="#00FFFFFF"
                                android:angle="270" />
                            <corners android:radius="9dp" />
                        </shape>
                    </item>
                    <item android:top="6dp" android:bottom="6dp" android:left="2dp" android:right="2dp">
                        <shape>
                            <gradient
                                android:angle="45"
                                android:startColor="#00FFFFFF"
                                android:centerColor="#30FF2A2A"
                                android:endColor="#00FFFFFF"
                                android:type="linear" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
