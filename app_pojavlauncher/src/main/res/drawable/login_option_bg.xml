<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR UI v5: login option glass row + soft shadow + ripple (no border) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2EFF4D6D">
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:angle="270" android:startColor="#14000000" android:endColor="#66000000" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:angle="90" android:startColor="#8C121624" android:endColor="#700D1019" />
                </shape>
            </item>
            <item android:bottom="4dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
