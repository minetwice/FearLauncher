<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#4DFFFFFF">
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="16dp"/>
            <solid android:color="#FFFFFFFF"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <!-- Red glow background offset -->
            <item android:left="-4dp" android:right="-4dp" android:top="-4dp" android:bottom="-4dp">
                <shape>
                    <solid android:color="#33E11D2E"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
            <!-- Main premium crimson red to bright red gradient -->
            <item>
                <shape>
                    <gradient
                        android:startColor="#FFe11d2e"
                        android:centerColor="#FFff2d3f"
                        android:endColor="#FFb3121f"
                        android:angle="0"/>
                    <corners android:radius="16dp"/>
                    <stroke android:width="1dp" android:color="#4DFFFFFF"/>
                </shape>
            </item>
            <!-- Shimmer gloss overlay -->
            <item android:top="1dp" android:left="2dp" android:right="2dp">
                <shape>
                    <gradient
                        android:startColor="#66FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:angle="270"/>
                    <corners android:radius="15dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
