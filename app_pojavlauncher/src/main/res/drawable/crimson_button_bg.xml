<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR UI v8: crimson gradient button with soft shadow depth + ripple (selected state) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40DC143C">
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient android:angle="270" android:startColor="#B3000510" android:endColor="#D9000208" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient android:angle="0" android:startColor="#DC143C" android:endColor="#7A0A18" />
                </shape>
            </item>
            <item android:bottom="3dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
