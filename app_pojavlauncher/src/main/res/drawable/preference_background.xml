<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#CC#333333"
                android:endColor="#CC#1A1A1A"
                android:angle="135" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape>
            <gradient
                android:startColor="#AA#222222"
                android:endColor="#AA#000000"
                android:angle="135" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Normal state -->
    <item>
        <shape>
            <gradient
                android:startColor="#88#1A1A1A"
                android:endColor="#88#000000"
                android:angle="135" />
            <stroke
                android:width="1.5dp"
                android:color="#44#FFFFFF" />
            <corners android:radius="14dp" />
            <padding
                android:left="16dp"
                android:top="14dp"
                android:right="16dp"
                android:bottom="14dp" />
        </shape>
    </item>
</selector>
