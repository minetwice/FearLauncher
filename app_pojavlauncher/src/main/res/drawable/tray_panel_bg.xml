<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR UI v5: hamburger panel glass with top sheen (no border) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="0dp" android:bottomLeftRadius="0dp"
                android:topRightRadius="26dp" android:bottomRightRadius="26dp" />
            <gradient android:angle="0" android:startColor="#F207080B" android:endColor="#E60B0D11" />
        </shape>
    </item>
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="0dp" android:bottomLeftRadius="0dp"
                android:topRightRadius="24dp" android:bottomRightRadius="24dp" />
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
