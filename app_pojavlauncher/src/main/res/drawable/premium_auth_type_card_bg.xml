<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected State (Red Neon Glow) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#26#4D9BFF" />
            <corners android:radius="@dimen/_10sdp" />
            <stroke
                android:width="2dp"
                android:color="#7CB9FF" />
        </shape>
    </item>

    <!-- Default Unselected State (Subtle Glass Black with thin border) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A#FFFFFF" />
            <corners android:radius="@dimen/_10sdp" />
            <stroke
                android:width="1dp"
                android:color="#26#FFFFFF" />
        </shape>
    </item>
</selector>
