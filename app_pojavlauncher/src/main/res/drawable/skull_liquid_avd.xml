<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR UI v7: skull icon with liquid pipe flow stroke animation (plays on click) -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <!-- skull -->
            <path
                android:name="skull"
                android:fillColor="#FFFFFF"
                android:pathData="M6,2h12v2h2v10h-2v2h-2v4h-2v-2h-4v2h-2v-4H8v-2H6V4h2V2z" />
            <path
                android:name="eyes"
                android:fillColor="#000000"
                android:pathData="M9,7h2v3h-2z M13,7h2v3h-2z" />
            <path
                android:fillColor="#000000"
                android:pathData="M11,11h2v1h-2z" />
            <!-- liquid pipe: wavy stroke flowing under the skull -->
            <path
                android:name="liquid_pipe"
                android:pathData="M2,19 C5,17 7,21 10,19 C13,17 15,21 18,19 C20,17.7 21,18.5 22,19"
                android:strokeColor="#DC143C"
                android:strokeWidth="1.6"
                android:strokeLineCap="round" />
        </vector>
    </aapt:attr>
    <target android:name="liquid_pipe">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="900"
                android:repeatCount="infinite"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
