<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_6sdp"
    android:background="@drawable/premium_glass_black_bg"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/_8sdp">

    <!-- Avatar User Icon -->
    <ImageView
        android:id="@+id/account_avatar"
        android:layout_width="@dimen/_24sdp"
        android:layout_height="@dimen/_24sdp"
        android:src="@drawable/ic_account_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:tint="#66FFFFFF" />

    <!-- Name & Type -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/status_layout"
        app:layout_constraintStart_toEndOf="@id/account_avatar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/account_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/account_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Microsoft"
            android:textColor="#80FFFFFF"
            android:textSize="@dimen/_7ssp" />

    </LinearLayout>

    <!-- Status Column (matches reference exactly) -->
    <LinearLayout
        android:id="@+id/status_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/account_delete_btn">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status"
            android:textColor="#40FFFFFF"
            android:textSize="@dimen/_6ssp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <!-- Active / Local colored dot -->
            <View
                android:id="@+id/account_status_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@android:color/holo_red_light"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/account_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active"
                android:textColor="#FF4D4D"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Menu or Action Options Button (we can show three dots) -->
    <ImageButton
        android:id="@+id/account_delete_btn"
        android:layout_width="@dimen/_24sdp"
        android:layout_height="@dimen/_24sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_three_dots"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#80FFFFFF" />

</androidx.constraintlayout.widget.ConstraintLayout>
