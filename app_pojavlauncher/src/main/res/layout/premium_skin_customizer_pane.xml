<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="@drawable/fear_ambient_bg">

    <!-- Left Pane: Current Active Skin -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.45"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="6dp"
        android:background="@drawable/fear_glass_panel_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SKIN STUDIO"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <com.kdt.mcgui.MinecraftSkinView
            android:id="@+id/skin_current_viewer"
            android:layout_width="140dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Model Type (Steve vs Alex) Toggle Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/skin_btn_steve_model"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="STEVE (4-PX)"
                android:textColor="#000000"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="@drawable/fear_play_button_bg"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/skin_btn_alex_model"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ALEX (3-PX)"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="@drawable/fear_glass_panel_bg" />

        </LinearLayout>

    </LinearLayout>

    <!-- Vertical Divider Line -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#33FFFFFF"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp" />

    <!-- Right Pane: Local Skin Library Repository -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.55"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FEATHER-STYLE LIBRARY"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/skin_library_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

        </HorizontalScrollView>

    </LinearLayout>

</LinearLayout>
