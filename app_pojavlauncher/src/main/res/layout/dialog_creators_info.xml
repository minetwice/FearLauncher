<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/_400sdp"
    android:layout_height="@dimen/_250sdp"
    android:background="@drawable/premium_dialog_bg"
    android:padding="@dimen/_12sdp">

    <!-- Title and Subtitle -->
    <TextView
        android:id="@+id/info_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FEAR CREATIVE HUD"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_14ssp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/info_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Meet the visionaries behind the ultimate launcher"
        android:textColor="#80FFFFFF"
        android:textSize="@dimen/_8ssp"
        app:layout_constraintTop_toBottomOf="@id/info_title"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Creators Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintTop_toBottomOf="@id/info_subtitle"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- TWICEFEAR PANEL -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/_4sdp"
            android:background="@drawable/premium_glass_black_bg"
            android:padding="@dimen/_6sdp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👑 OWNER &amp; DEV"
                android:textColor="#FFFF55"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="twicefear"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The brain behind FEAR's graphics. Specializes in advanced Vulkan pipelines, epic HDR coloring, and ultra-high FPS mods."
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_6ssp"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:layout_weight="1"/>

            <!-- YouTube Button -->
            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_yt_twicefear"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_24sdp"
                android:text="📺 TWICEFEAR"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_youtube_logo"
                android:paddingHorizontal="4dp"
                android:background="@drawable/premium_red_button_bg" />

        </LinearLayout>

        <!-- HELLZIOR PANEL -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/_2sdp"
            android:background="@drawable/premium_glass_black_bg"
            android:padding="@dimen/_6sdp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ CO-OWNER &amp; DEV"
                android:textColor="#55FF55"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="hellzior"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The wizard of client execution. Masters the JRE environment, junk cleaner logic, and zero-stutter PvP integrations."
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_6ssp"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:layout_weight="1"/>

            <!-- YouTube Button -->
            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_yt_hellzior"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_24sdp"
                android:text="📺 HELLZIOR"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_youtube_logo"
                android:paddingHorizontal="4dp"
                android:background="@drawable/premium_red_button_bg" />

        </LinearLayout>

        <!-- CREDITS PANEL -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_marginStart="@dimen/_4sdp"
            android:background="@drawable/premium_glass_black_bg"
            android:padding="@dimen/_6sdp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ CO-DEVELOPERS"
                android:textColor="#FF55FF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="itz crazy playz"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A visionary dev shaping PojavLauncher controls remappers and mobile-optimizations."
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_6ssp"
                android:gravity="center"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ THANKS FOR PLAYING"
                android:textColor="#FFB300"
                android:textSize="@dimen/_6ssp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
