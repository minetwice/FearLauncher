<?xml version="1.0" encoding="utf-8"?>
<!-- Redesigned FEAR Open Configuration Dashboard — 2026 Dual-Pane Sci-Fi Control Cockpit -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg"
    android:padding="12dp">

    <!-- Top Action Bar Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settings_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/settings_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_px_arrow_left"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FF003C"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/settings_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FEAR ENGINE SYSTEM CONFIGURATION"
            android:textColor="#FF003C"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/settings_back" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Horizontal separation line -->
    <View
        android:id="@+id/settings_header_divider"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#FF003C"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/settings_header" />

    <!-- Dual-Pane Workspace Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/settings_header_divider"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- LEFT PANEL: HIGH-TECH DIAGNOSTICS & TELEMETRY TERMINAL -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="@drawable/premium_glass_black_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CORE ENGINE DIAGNOSTICS"
                android:textColor="#FF003C"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FF003C"
                android:layout_marginBottom="12dp" />

            <!-- Subsystem Status Indicators -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[REACTION CORE: ACTIVE]"
                android:textColor="#42FF42"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[MESA DRIVERS: BYPASSED]"
                android:textColor="#42FF42"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[RENDER THREAD: DELEGATED]"
                android:textColor="#42FF42"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• COMPLIANCE STATUS"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Optimized for multi-threaded performance. Native JNI layers running smoothly."
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AFFFFFF"
                android:layout_marginBottom="12dp" />

            <!-- Logo representation -->
            <ImageView
                android:layout_width="@dimen/_48sdp"
                android:layout_height="@dimen/_48sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_app_logo"
                android:alpha="0.8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:text="FEAR ULTRATIVE"
                android:textColor="#FF003C"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

        </LinearLayout>

        <!-- RIGHT PANEL: CONFIGURATION LIST (RecyclerView list wrapper) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:background="@drawable/premium_glass_black_bg"
            android:padding="4dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/settings_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:clipToPadding="false"
                android:scrollbars="vertical"
                android:scrollbarThumbVertical="@drawable/silver_scrollbar" />

        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
