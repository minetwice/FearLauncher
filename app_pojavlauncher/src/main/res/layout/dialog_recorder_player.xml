<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR RECORDER — in-dashboard video player -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <VideoView
        android:id="@+id/rec_player_video"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rec_player_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom control bar -->
    <LinearLayout
        android:id="@+id/rec_player_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E6050102"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.kdt.mcgui.MineButton
                android:id="@+id/rec_player_play"
                android:layout_width="88dp"
                android:layout_height="38dp"
                android:text="PAUSE"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:background="@drawable/crimson_button_bg" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/rec_player_stop"
                android:layout_width="88dp"
                android:layout_height="38dp"
                android:text="STOP"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:background="@drawable/premium_red_button_bg"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/rec_player_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00 / 00:00"
                android:textColor="#DC143C"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginStart="8dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/rec_player_close"
                android:layout_width="88dp"
                android:layout_height="38dp"
                android:text="CLOSE"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:background="@drawable/crimson_button_bg"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/rec_player_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:progressTint="#DC143C"
            android:thumbTint="#DC143C" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
