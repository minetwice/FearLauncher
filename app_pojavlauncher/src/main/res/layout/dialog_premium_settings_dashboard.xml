<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg"
    android:padding="12dp">

    <!-- Top Header -->
    <ImageButton
        android:id="@+id/dash_back_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_px_arrow_left"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/dash_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CORE COMMAND CENTER"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_14ssp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="@id/dash_back_btn"
        app:layout_constraintBottom_toBottomOf="@id/dash_back_btn"
        app:layout_constraintStart_toEndOf="@id/dash_back_btn" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/dash_done_btn"
        android:layout_width="72dp"
        android:layout_height="32dp"
        android:text="DONE"
        android:textColor="#000000"
        android:textSize="@dimen/_8ssp"
        android:textStyle="bold"
        android:background="@drawable/premium_button_bg"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/dash_header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/dash_back_btn" />

    <!-- Split Pane Workspace -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/dash_header_divider"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Left Navigation Rail Column -->
        <ScrollView
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:background="@drawable/premium_glass_black_bg"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM CORES"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/dash_nav_settings"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="SETTINGS"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/dash_nav_execute"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="RUN JAR"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IDENTITY CORE"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/dash_nav_skin"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="SKINS"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/dash_nav_account"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="ACCOUNTS"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EXPANSION HUB"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/dash_nav_controls"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="CONTROLS"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/dash_nav_mods"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="MODS DEPLOY"
                    android:textColor="#000000"
                    android:textSize="@dimen/_8ssp"
                    android:background="@drawable/premium_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/dash_nav_logs"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="TELEMETRY"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:background="@drawable/premium_glass_black_bg" />

            </LinearLayout>
        </ScrollView>

        <!-- Right Content Work Pane -->
        <FrameLayout
            android:id="@+id/dash_content_pane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/premium_glass_black_bg"
            android:padding="8dp">

            <!-- Default / Fallback panel inside Pane -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="SELECT AN OPERATIONAL MODULE"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
