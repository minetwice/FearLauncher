<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Main Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:animateLayoutChanges="true"
        android:background="@drawable/premium_gradient_bg">

        <!-- Toolbar with Hamburger -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/top_bar_bg"
            android:elevation="4dp"
            app:titleTextColor="@color/primary_text"
            app:title="Fear Launcher">

            <ImageButton
                android:id="@+id/hamburger_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_hamburger"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:layout_gravity="start"
                android:tint="@color/primary_text"
                android:contentDescription="Menu" />

        </androidx.appcompat.widget.Toolbar>

        <!-- Fragment Container -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/container_fragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />


    </LinearLayout>

        <!-- global red/blue wash: sits over every screen so the accent cycle is
             identical everywhere instead of per-screen -->
        <View
            android:id="@+id/fear_global_wash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:background="#00FF2B3A" />


        <!-- FEAR download bar: topmost layer, so it shows over EVERY screen
             whenever anything is downloading. Status sits UNDER the bar. -->
        <LinearLayout
            android:id="@+id/fear_dl_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/_8sdp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:elevation="40dp"
            android:visibility="gone">

            <com.kdt.mcgui.FearBarView
                android:id="@+id/fear_dl_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_2sdp" />

            <TextView
                android:id="@+id/fear_dl_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#FFFFD9A0"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:layout_marginTop="@dimen/_1sdp" />
        </LinearLayout>
    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>
