<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR asset detail sheet: preview, spec, version picker, install -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FA000000"
    android:fitsSystemWindows="true"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:padding="@dimen/_10sdp">

    <!-- ===== TOP BAR ===== -->
    <ImageButton
        android:id="@+id/detail_close_btn"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:src="@drawable/ic_px_arrow_left"
        android:background="@drawable/fear_search_bg"
        android:padding="@dimen/_8sdp"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/detail_done_btn"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_38sdp"
        android:minWidth="@dimen/_60sdp"
        android:paddingHorizontal="@dimen/_12sdp"
        android:text="DONE"
        android:textColor="#000000"
        android:textSize="@dimen/_9ssp"
        android:textStyle="bold"
        android:maxLines="1"
        android:background="@drawable/theme_button_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/detail_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="ASSET SPECIFICATION"
        android:textColor="#CCFFFFFF"
        android:textSize="@dimen/_9ssp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintTop_toTopOf="@id/detail_close_btn"
        app:layout_constraintBottom_toBottomOf="@id/detail_close_btn"
        app:layout_constraintStart_toEndOf="@id/detail_close_btn"
        app:layout_constraintEnd_toStartOf="@id/detail_done_btn" />

    <!-- ===== HERO ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detail_top_spec_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/fear_panel_bg"
        android:padding="@dimen/_12sdp"
        app:layout_constraintTop_toBottomOf="@id/detail_close_btn">

        <androidx.cardview.widget.CardView
            android:id="@+id/detail_logo_card"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#33FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/detail_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/detail_title_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintTop_toTopOf="@id/detail_logo_card"
            app:layout_constraintBottom_toBottomOf="@id/detail_logo_card"
            app:layout_constraintStart_toEndOf="@id/detail_logo_card"
            app:layout_constraintEnd_toStartOf="@id/detail_install_btn">

            <TextView
                android:id="@+id/detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/_4sdp">
                <ImageView
                    android:id="@+id/detail_source_icon"
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp" />
                <TextView
                    android:id="@+id/detail_source_text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginStart="@dimen/_4sdp" />
            </LinearLayout>
        </LinearLayout>

        <com.kdt.mcgui.MineButton
            android:id="@+id/detail_install_btn"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_34sdp"
            android:minWidth="@dimen/_72sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:text="INSTALL"
            android:textColor="#000000"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:background="@drawable/theme_button_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== COMPACT SPEC ROW: tap the arrow to open the tray ===== -->
    <LinearLayout
        android:id="@+id/detail_spec_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/fear_panel_bg"
        android:paddingHorizontal="@dimen/_12sdp"
        app:layout_constraintTop_toBottomOf="@id/detail_top_spec_row">

        <TextView
            android:id="@+id/detail_spec_summary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="VERSION &amp; LOADER"
            android:textColor="#CCFFFFFF"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/detail_spec_arrow"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:src="@drawable/ic_fear_chevron"
            android:background="@drawable/fear_search_bg"
            android:padding="@dimen/_7sdp"
            android:contentDescription="@null"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- ===== VERSION / MODLOADER TRAY (hidden until the arrow is tapped) ===== -->
    <LinearLayout
        android:id="@+id/detail_selector_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="@dimen/_6sdp"
        android:background="@drawable/fear_panel_bg"
        android:padding="@dimen/_12sdp"
        app:layout_constraintTop_toBottomOf="@id/detail_spec_row">

        <LinearLayout
            android:id="@+id/detail_modloader_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODLOADER"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/detail_modloader_spinner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:background="@drawable/fear_search_bg" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VERSION"
            android:textColor="#80FFFFFF"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/detail_version_spinner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="@drawable/fear_search_bg" />
    </LinearLayout>

    <!-- ===== RELEASE TYPE FILTER ===== -->
    <LinearLayout
        android:id="@+id/detail_type_filters"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_32sdp"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintTop_toBottomOf="@id/detail_selector_hud">

        <com.kdt.mcgui.MineButton
            android:id="@+id/filter_type_all"
            android:layout_width="0dp"
            android:minWidth="0dp"
                android:minHeight="0dp"
                android:includeFontPadding="false"
                android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ALL"
            android:textSize="@dimen/_8ssp"
            android:textColor="#000000"
            android:maxLines="1"
            android:background="@drawable/premium_button_bg"
            android:layout_marginEnd="4dp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/filter_type_release"
            android:layout_width="0dp"
            android:minWidth="0dp"
                android:minHeight="0dp"
                android:includeFontPadding="false"
                android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="RELEASE"
            android:textSize="@dimen/_8ssp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:background="@drawable/premium_glass_black_bg"
            android:layout_marginEnd="4dp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/filter_type_beta"
            android:layout_width="0dp"
            android:minWidth="0dp"
                android:minHeight="0dp"
                android:includeFontPadding="false"
                android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="BETA"
            android:textSize="@dimen/_8ssp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:background="@drawable/premium_glass_black_bg"
            android:layout_marginEnd="4dp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/filter_type_alpha"
            android:layout_width="0dp"
            android:minWidth="0dp"
                android:minHeight="0dp"
                android:includeFontPadding="false"
                android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ALPHA"
            android:textSize="@dimen/_8ssp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:background="@drawable/premium_glass_black_bg" />
    </LinearLayout>

    <!-- ===== PREVIEW + DESCRIPTION ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_8sdp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/detail_type_filters"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_12sdp">

            <TextView
                android:id="@+id/detail_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFF6B5E"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/_8sdp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/detail_preview_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33120A12">
                <ImageView
                    android:id="@+id/detail_preview_image"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_120sdp"
                    android:scaleType="centerCrop" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESCRIPTION"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_4sdp" />

            <TextView
                android:id="@+id/detail_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF"
                android:textSize="@dimen/_11ssp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
