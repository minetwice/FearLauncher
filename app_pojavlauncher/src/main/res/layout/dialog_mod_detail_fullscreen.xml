<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg"
    android:padding="12dp">

    <!-- Top Header Navigation HUD -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detail_header_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/premium_glass_black_bg"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/detail_close_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_px_arrow_left"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/detail_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="TELEMETRY SYSTEM: PROVISIONING PROTOCOL"
            android:textColor="#E0E0E0"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/detail_close_btn"
            app:layout_constraintEnd_toStartOf="@id/detail_done_btn" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/detail_done_btn"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:text="DONE"
            android:textColor="#000000"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold"
            android:background="@drawable/premium_button_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Left side Info Panel (Icons, spinners, version selector tabs) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detail_left_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/premium_glass_black_bg"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/detail_header_hud"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/detail_right_panel_guideline">

        <!-- Logo & Spec Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/detail_logo_card"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/detail_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <!-- Title, Source Text & Action button -->
        <TextView
            android:id="@+id/detail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginStart="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/detail_logo_card"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/detail_source_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/detail_title"
            app:layout_constraintStart_toEndOf="@id/detail_logo_card"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageView
                android:id="@+id/detail_source_icon"
                android:layout_width="14dp"
                android:layout_height="14dp" />
            <TextView
                android:id="@+id/detail_source_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Interactive Custom Selector Dropdowns -->
        <LinearLayout
            android:id="@+id/detail_dropdowns_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/detail_logo_card">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOADER ENGINE"
                    android:textColor="#A0E0E0"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp" />
                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/detail_modloader_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/premium_glass_black_bg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GAME VERSION"
                    android:textColor="#A0E0E0"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp" />
                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/detail_version_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/premium_glass_black_bg" />
            </LinearLayout>
        </LinearLayout>

        <!-- Segment Filter Tabs (ALL, RELEASE, BETA, SNAPSHOT) -->
        <LinearLayout
            android:id="@+id/detail_filter_tabs"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/detail_dropdowns_row">

            <com.kdt.mcgui.MineButton
                android:id="@+id/filter_type_all"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ALL"
                android:textSize="@dimen/_8ssp"
                android:textColor="#000000"
                android:background="@drawable/premium_button_bg"
                android:layout_marginEnd="4dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/filter_type_release"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="RELEASE"
                android:textSize="@dimen/_8ssp"
                android:textColor="#FFFFFF"
                android:background="@drawable/premium_glass_black_bg"
                android:layout_marginEnd="4dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/filter_type_beta"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="BETA"
                android:textSize="@dimen/_8ssp"
                android:textColor="#FFFFFF"
                android:background="@drawable/premium_glass_black_bg"
                android:layout_marginEnd="4dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/filter_type_alpha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="SNAPSHOT"
                android:textSize="@dimen/_8ssp"
                android:textColor="#FFFFFF"
                android:background="@drawable/premium_glass_black_bg" />
        </LinearLayout>

        <!-- Prominent Install Action Button -->
        <com.kdt.mcgui.MineButton
            android:id="@+id/detail_install_btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="DEPLOY PACKAGE"
            android:textColor="#000000"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold"
            android:background="@drawable/premium_button_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="4dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Vertical Guideline to split Left and Right sides beautifully in landscape -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/detail_right_panel_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.45" />

    <!-- Right side detail documentation and manual view -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detail_right_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/premium_glass_black_bg"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/detail_header_hud"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/detail_right_panel_guideline"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Error Telemetry alerts -->
                <TextView
                    android:id="@+id/detail_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FF4D4D"
                    android:textSize="@dimen/_9ssp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- Gallery screenshot card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/detail_preview_card"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:visibility="gone"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#20FFFFFF"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/detail_preview_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DOCUMENTATION &amp; SPECIFICATIONS"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/detail_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#EAEAEA"
                    android:textSize="@dimen/_10ssp"
                    android:lineSpacingMultiplier="1.3"
                    android:textIsSelectable="true" />

            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
