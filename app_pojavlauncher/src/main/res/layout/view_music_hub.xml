<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Title and Search Row -->
    <TextView
        android:id="@+id/music_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ONLINE TRANSMISSION CHANNELS"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_11ssp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Volume Controller Bar -->
    <LinearLayout
        android:id="@+id/music_volume_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/premium_edit_bg"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/music_title_text">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AMPLITUDE VOLUME"
            android:textColor="#80FFFFFF"
            android:textSize="@dimen/_7ssp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/music_volume_seekbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="60"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <com.kdt.mcgui.MineEditText
        android:id="@+id/music_search_edittext"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/premium_edit_bg"
        android:hint="SEARCH TRANSMISSION AUDIO..."
        android:textColor="#FFFFFF"
        android:textColorHint="#40FFFFFF"
        android:paddingHorizontal="10dp"
        android:textSize="@dimen/_9ssp"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="6dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/music_volume_container" />

    <!-- Songs List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/music_search_edittext"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/music_tracks_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tracks will be dynamically populated/filtered here in code! -->

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
