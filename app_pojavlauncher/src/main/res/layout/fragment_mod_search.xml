<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg"
    android:padding="@dimen/_12sdp">

    <!-- Header Overlay (Glassmorphism Control Center) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_mod_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/premium_glass_black_bg"
        android:padding="@dimen/_10sdp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Category Selector Tabs -->
        <LinearLayout
            android:id="@+id/downloader_tabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_32sdp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_modpacks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="MODPACKS"
                android:textSize="@dimen/_9ssp"
                android:textColor="#000000"
                android:background="@drawable/premium_button_bg"
                android:layout_marginEnd="4dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_mods"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="MODS"
                android:textSize="@dimen/_9ssp"
                android:textColor="#FFFFFF"
                android:background="@drawable/premium_glass_black_bg"
                android:layout_marginEnd="4dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_resourcepacks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="RESOURCES"
                android:textSize="@dimen/_9ssp"
                android:textColor="#FFFFFF"
                android:background="@drawable/premium_glass_black_bg"
                android:layout_marginEnd="4dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_shaders"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="SHADERS"
                android:textSize="@dimen/_9ssp"
                android:textColor="#FFFFFF"
                android:background="@drawable/premium_glass_black_bg" />
        </LinearLayout>

        <com.kdt.mcgui.MineEditText
            android:id="@+id/search_mod_edittext"
            android:layout_width="0dp"
            android:layout_height="@dimen/_36sdp"
            android:background="@drawable/premium_edit_bg"
            android:hint="SEARCH PROTOCOL..."
            android:textColor="#FFFFFF"
            android:textColorHint="#50FFFFFF"
            android:paddingHorizontal="@dimen/_12sdp"
            android:textSize="@dimen/_11ssp"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            app:layout_constraintEnd_toStartOf="@+id/search_mod_filter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/downloader_tabs"
            android:layout_marginTop="8dp" />

        <ImageButton
            android:id="@+id/search_mod_filter"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_filter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/downloader_tabs"
            android:layout_marginTop="8dp"
            app:tint="#FFFFFF" />

        <ProgressBar
            android:id="@+id/search_mod_progressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:progressDrawable="@drawable/view_text_progressbar"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/search_mod_edittext"
            android:layout_marginTop="8dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_mod_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        app:layout_constraintTop_toBottomOf="@id/search_mod_overlay"
        app:layout_constraintBottom_toTopOf="@+id/mineButton_import_local_modpack" />

    <TextView
        android:id="@+id/search_mod_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NO DATA STREAMS FOUND"
        android:textColor="#80FFFFFF"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/search_mod_list"
        app:layout_constraintEnd_toEndOf="@+id/search_mod_list"
        app:layout_constraintStart_toStartOf="@+id/search_mod_list"
        app:layout_constraintTop_toTopOf="@+id/search_mod_list" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/mineButton_import_local_modpack"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:text="IMPORT EXTERNAL MODPACK"
        android:textColor="#000000"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold"
        android:background="@drawable/premium_button_bg"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
