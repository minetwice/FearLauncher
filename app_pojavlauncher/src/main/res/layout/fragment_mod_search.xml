<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR DOWNLOAD CENTRE - mods / shaders / resource packs for the selected instance -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/theme_bg"
    android:padding="@dimen/_12sdp">

    <!-- ===== CONTROL DECK ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_mod_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fear_panel_bg"
        android:padding="@dimen/_12sdp"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/fear_deck_stripe"
            android:layout_width="4dp"
            android:layout_height="@dimen/_30sdp"
            android:background="@drawable/fear_accent_stripe"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/search_mod_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="DOWNLOAD CENTRE"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/fear_deck_stripe"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/fear_deck_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="ASSETS DEPLOY INTO YOUR SELECTED INSTANCE"
            android:textColor="#80FFFFFF"
            android:textSize="@dimen/_7ssp"
            android:letterSpacing="0.06"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/fear_deck_stripe"
            app:layout_constraintTop_toBottomOf="@id/search_mod_header_title" />

        <!-- asset class selector -->
        <LinearLayout
            android:id="@+id/downloader_tabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_34sdp"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_12sdp"
            app:layout_constraintTop_toBottomOf="@id/fear_deck_subtitle"
            app:layout_constraintStart_toStartOf="parent">

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_modpacks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="MODPACKS"
                android:textSize="@dimen/_8ssp"
                android:textColor="#000000"
                android:background="@drawable/premium_button_bg"
                android:layout_marginEnd="4dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_mods"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="MODS"
                android:textSize="@dimen/_8ssp"
                android:textColor="#FFFFFF"
                android:background="@drawable/premium_glass_black_bg"
                android:layout_marginEnd="4dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_resourcepacks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="RESOURCES"
                android:textSize="@dimen/_8ssp"
                android:textColor="#FFFFFF"
                android:background="@drawable/premium_glass_black_bg"
                android:layout_marginEnd="4dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_shaders"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="SHADERS"
                android:textSize="@dimen/_8ssp"
                android:textColor="#FFFFFF"
                android:background="@drawable/premium_glass_black_bg" />
        </LinearLayout>

        <!-- search -->
        <com.kdt.mcgui.MineEditText
            android:id="@+id/search_mod_edittext"
            android:layout_width="0dp"
            android:layout_height="@dimen/_38sdp"
            android:background="@drawable/fear_search_bg"
            android:hint="SEARCH THE ARCHIVE..."
            android:textColor="#FFFFFF"
            android:textColorHint="#50FFFFFF"
            android:paddingHorizontal="@dimen/_12sdp"
            android:textSize="@dimen/_11ssp"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            app:layout_constraintEnd_toStartOf="@+id/search_mod_done_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/downloader_tabs"
            android:layout_marginTop="@dimen/_10sdp" />

        <ImageButton
            android:id="@+id/search_mod_filter"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/fear_search_bg"
            android:src="@drawable/ic_filter"
            android:padding="@dimen/_8sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/downloader_tabs"
            android:layout_marginTop="@dimen/_10sdp"
            app:tint="#FFFFFF" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/search_mod_done_btn"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_38sdp"
            android:minWidth="@dimen/_56sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:text="DONE"
            android:textColor="#000000"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:background="@drawable/theme_button_bg"
            app:layout_constraintEnd_toStartOf="@+id/search_mod_filter"
            app:layout_constraintTop_toBottomOf="@id/downloader_tabs"
            android:layout_marginTop="@dimen/_10sdp" />

        <ProgressBar
            android:id="@+id/search_mod_progressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:progressDrawable="@drawable/view_text_progressbar"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/search_mod_edittext"
            android:layout_marginTop="@dimen/_8sdp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== RESULTS ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_mod_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="@dimen/_6sdp"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintTop_toBottomOf="@id/search_mod_overlay"
        app:layout_constraintBottom_toTopOf="@+id/mineButton_import_local_modpack" />

    <TextView
        android:id="@+id/search_mod_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NO DATA STREAMS FOUND"
        android:textColor="#80FFFFFF"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/search_mod_list"
        app:layout_constraintEnd_toEndOf="@+id/search_mod_list"
        app:layout_constraintStart_toStartOf="@+id/search_mod_list"
        app:layout_constraintTop_toTopOf="@+id/search_mod_list" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/mineButton_import_local_modpack"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:text="IMPORT EXTERNAL MODPACK"
        android:textColor="#000000"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold"
        android:background="@drawable/theme_button_bg"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
