<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR DOWNLOAD CENTRE - modelled on the reference: a control deck, a vertical
     asset-class rail on the left, and a titled panel with a two-column card grid -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/theme_bg"
    android:padding="@dimen/_10sdp">

    <!-- ===== CONTROL DECK ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_mod_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fear_panel_bg"
        android:padding="@dimen/_12sdp"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/fear_deck_stripe"
            android:layout_width="4dp"
            android:layout_height="@dimen/_30sdp"
            android:background="@drawable/fear_accent_stripe"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/search_mod_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="DOWNLOAD CENTRE"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/fear_deck_stripe"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/fear_deck_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="ASSETS DEPLOY INTO YOUR SELECTED INSTANCE"
            android:textColor="#80FFFFFF"
            android:textSize="@dimen/_7ssp"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/fear_deck_stripe"
            app:layout_constraintTop_toBottomOf="@id/search_mod_header_title" />

        <com.kdt.mcgui.MineEditText
            android:id="@+id/search_mod_edittext"
            android:layout_width="0dp"
            android:layout_height="@dimen/_38sdp"
            android:background="@drawable/fear_search_bg"
            android:hint="SEARCH THE ARCHIVE..."
            android:textColor="#FFFFFF"
            android:textColorHint="#50FFFFFF"
            android:paddingHorizontal="@dimen/_12sdp"
            android:textSize="@dimen/_11ssp"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            app:layout_constraintEnd_toStartOf="@+id/search_mod_done_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fear_deck_subtitle"
            android:layout_marginTop="@dimen/_10sdp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/search_mod_done_btn"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_38sdp"
            android:minWidth="@dimen/_56sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:text="DONE"
            android:textColor="#000000"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:background="@drawable/theme_button_bg"
            app:layout_constraintEnd_toStartOf="@+id/search_mod_filter"
            app:layout_constraintTop_toBottomOf="@id/fear_deck_subtitle"
            android:layout_marginTop="@dimen/_10sdp" />

        <ImageButton
            android:id="@+id/search_mod_filter"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:background="@drawable/fear_search_bg"
            android:src="@drawable/ic_filter"
            android:padding="@dimen/_8sdp"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fear_deck_subtitle"
            android:layout_marginTop="@dimen/_10sdp"
            app:tint="#FFFFFF" />

        <ProgressBar
            android:id="@+id/search_mod_progressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:progressDrawable="@drawable/view_text_progressbar"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/search_mod_edittext"
            android:layout_marginTop="@dimen/_8sdp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== ASSET CLASS RAIL (left) + CONTENT ===== -->
    <LinearLayout
        android:id="@+id/fear_content_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintTop_toBottomOf="@id/search_mod_overlay"
        app:layout_constraintBottom_toTopOf="@+id/mineButton_import_local_modpack">

        <LinearLayout
            android:id="@+id/downloader_tabs"
            android:layout_width="@dimen/_104sdp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingEnd="@dimen/_8sdp">

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_modpacks"
                android:layout_width="match_parent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:includeFontPadding="false"
                android:layout_height="@dimen/_36sdp"
                android:text="MODPACKS"
                android:textSize="@dimen/_8ssp"
                android:textColor="#000000"
                android:maxLines="1"
                android:background="@drawable/premium_button_bg"
                android:layout_marginBottom="@dimen/_6sdp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_mods"
                android:layout_width="match_parent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:includeFontPadding="false"
                android:layout_height="@dimen/_36sdp"
                android:text="MODS"
                android:textSize="@dimen/_8ssp"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:background="@drawable/premium_glass_black_bg"
                android:layout_marginBottom="@dimen/_6sdp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_resourcepacks"
                android:layout_width="match_parent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:includeFontPadding="false"
                android:layout_height="@dimen/_36sdp"
                android:text="RESOURCES"
                android:textSize="@dimen/_8ssp"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:background="@drawable/premium_glass_black_bg"
                android:layout_marginBottom="@dimen/_6sdp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_shaders"
                android:layout_width="match_parent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:includeFontPadding="false"
                android:layout_height="@dimen/_36sdp"
                android:text="SHADERS"
                android:textSize="@dimen/_8ssp"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:background="@drawable/premium_glass_black_bg" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/search_mod_panel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MODS"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/search_mod_panel_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Client mods you can install into your selected instance."
                android:textColor="#99FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="@dimen/_6sdp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/search_mod_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/search_mod_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NO DATA STREAMS FOUND"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <com.kdt.mcgui.MineButton
        android:id="@+id/mineButton_import_local_modpack"
        android:layout_width="match_parent"
        android:minWidth="0dp"
                android:minHeight="0dp"
                android:includeFontPadding="false"
                android:layout_height="@dimen/_42sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:text="IMPORT EXTERNAL MODPACK"
        android:textColor="#000000"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold"
        android:maxLines="1"
        android:background="@drawable/theme_button_bg"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
