<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg">

    <!-- Left Navigation Rail (Official Launcher Style) -->
    <LinearLayout
        android:id="@+id/sidebar_rail"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="@dimen/_16sdp"
        android:background="@drawable/mc_sidebar_bg"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:src="@mipmap/ic_launcher_foreground"
            android:layout_marginBottom="@dimen/_24sdp" />

        <!-- Java Edition (Home) -->
        <ImageButton
            android:id="@+id/tab_home"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:src="@drawable/ic_px_home"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/fear_primary"
            android:layout_marginBottom="@dimen/_12sdp"
            android:contentDescription="Home" />

        <!-- Installations -->
        <ImageButton
            android:id="@+id/tab_installations"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:src="@drawable/ic_px_runtime_mgr"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/secondary_text"
            android:layout_marginBottom="@dimen/_12sdp"
            android:contentDescription="Installations" />

        <!-- Skins -->
        <ImageButton
            android:id="@+id/tab_skin"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:src="@drawable/ic_account_circle"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/secondary_text"
            android:layout_marginBottom="@dimen/_12sdp"
            android:contentDescription="Skins" />

        <!-- Patch Notes / News -->
        <ImageButton
            android:id="@+id/tab_news"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:src="@drawable/ic_px_book"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/secondary_text"
            android:layout_marginBottom="@dimen/_12sdp"
            android:contentDescription="News" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Settings -->
        <ImageButton
            android:id="@+id/tab_settings_icon"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:src="@drawable/ic_px_sliders"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/secondary_text"
            android:layout_marginBottom="@dimen/_16sdp"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- Main Content Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@id/sidebar_rail"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header -->
        <TextView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MINECRAFT: JAVA EDITION"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_margin="@dimen/_16sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Featured Section (News Card) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/featured_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            app:cardCornerRadius="4dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/header_title"
            app:layout_constraintBottom_toTopOf="@+id/bottom_control_bar">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#121212">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/ic_launcher_foreground"
                    android:scaleType="centerCrop"
                    android:alpha="0.1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="@dimen/_16sdp"
                    android:background="#CC000000">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WHAT'S NEW"
                        android:textColor="@color/fear_primary"
                        android:textSize="@dimen/_8ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Java Edition: Modern Runtimes"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Support for JRE 18, 21, and 25 is now live. Enjoy better performance and compatibility."
                        android:textColor="@color/secondary_text"
                        android:textSize="@dimen/_9ssp" />
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bottom Control Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottom_control_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp"
            android:background="#222222"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Account Left -->
            <LinearLayout
                android:id="@+id/account_section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_4sdp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/account_avatar"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_account_circle" />

                <TextView
                    android:id="@+id/account_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:text="Guest"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_9ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Center Controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.kdt.mcgui.mcVersionSpinner
                    android:id="@+id/mc_version_spinner"
                    android:layout_width="@dimen/_130sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:background="#333333" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/play_button"
                    android:layout_width="@dimen/_110sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:text="PLAY"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold"
                    android:background="@drawable/mc_button_bg" />
            </LinearLayout>

            <!-- Edit Button Right -->
            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:src="@drawable/ic_px_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/secondary_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Invisible items for fragment logic -->
    <TextView android:id="@+id/account_type_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/version_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <ImageView android:id="@+id/hamburger_menu_icon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <!-- Options Tray (Overlay) - Kept for secondary settings access -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settings_tray"
        android:layout_width="@dimen/_220sdp"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="0dp"
        app:cardElevation="32dp"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/_16sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MENU"
                android:textColor="@color/fear_primary"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/_16sdp" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:text="Install .JAR"
                android:drawableStart="@drawable/ic_px_java_run" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:text="Custom Controls"
                android:drawableStart="@drawable/ic_px_gamepad" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_files_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:text="Game Directory"
                android:drawableStart="@drawable/ic_px_folder" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#20FFFFFF" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/tray_settings"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:text="Settings"
                android:drawableStart="@drawable/ic_px_sliders" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/tray_runtime"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:text="Runtimes"
                android:drawableStart="@drawable/ic_px_runtime_mgr" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button_tray"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:text="Share Logs"
                android:drawableStart="@drawable/ic_px_sharelog" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tray_close"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_32sdp"
                android:text="CLOSE"
                android:background="@drawable/mc_button_bg" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
