<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg">

    <!-- Three-Dot Menu Trigger (Top Right - Premium Glass Three-Dot) -->
    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/hamburger_menu_icon"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        android:layout_margin="@dimen/_12sdp"
        android:src="@drawable/ic_three_dots"
        android:background="@drawable/premium_glass_black_bg"
        android:padding="@dimen/_10sdp"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main Content Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.kdt.mcgui.GlassParticleView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.3" />

        <ImageView
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            android:src="@drawable/ic_app_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/_60sdp" />

        <!-- Profile / Version Info -->
        <LinearLayout
            android:id="@+id/main_info_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintBottom_toTopOf="@+id/bottom_launcher_control"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="@dimen/_20sdp">

            <TextView
                android:id="@+id/account_name_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guest"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/version_text_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.21.1"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FEAR ULTRA-CORE v4.0 [MANUFACTURED]"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:alpha="0.9"
                android:layout_marginTop="4dp"
                android:shadowColor="#FFFFFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CORE STABILITY: LOCKED"
                android:textColor="#00FFCC"
                android:textSize="@dimen/_6ssp"
                android:textStyle="bold"
                android:alpha="0.8" />
        </LinearLayout>

        <!-- Bottom Launcher Control -->
        <LinearLayout
            android:id="@+id/bottom_launcher_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="@dimen/_40sdp"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.kdt.mcgui.mcVersionSpinner
                    android:id="@+id/mc_version_spinner"
                    android:layout_width="@dimen/_160sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/premium_glass_black_bg" />

                <ImageButton
                    android:id="@+id/edit_profile_button_main"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_px_edit"
                    android:background="@drawable/premium_glass_black_bg"
                    app:tint="#FFFFFF" />
            </LinearLayout>

            <com.kdt.mcgui.MineButton
                android:id="@+id/play_button"
                android:layout_width="@dimen/_200sdp"
                android:layout_height="@dimen/_50sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="PLAY"
                android:textColor="#000000"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold"
                android:background="@drawable/premium_button_bg" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- UI Logic Dummies -->
    <TextView android:id="@+id/account_name" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/account_type_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/version_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/account_section" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/edit_profile_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_home" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_installations" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_skin" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_settings_icon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <!-- ULTRA-PROFESSIONAL GLASS SIDEBAR TRAY (Slides from Right) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settings_tray"
        android:layout_width="@dimen/_240sdp"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:cardBackgroundColor="#F2000000"
        app:cardCornerRadius="0dp"
        app:cardElevation="32dp"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tray_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_16sdp"
                android:background="@drawable/premium_glass_black_bg">

                <!-- Premium Header Profile Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/premium_edit_bg"
                    android:padding="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#20FFFFFF"
                        app:cardElevation="2dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_app_logo"
                            android:scaleType="centerCrop"
                            android:padding="6dp" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="COMMAND CORE"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TELEMETRY ACTIVE"
                            android:textColor="#00FFCC"
                            android:textSize="@dimen/_7ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Performance Diagnostics Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• SYSTEMS TELEMETRY"
                    android:textColor="#00FFCC"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <!-- Grid of Telemetry metrics -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="3"
                    android:alignmentMode="alignBounds"
                    android:layout_marginBottom="12dp">

                    <!-- Metric: FPS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/premium_edit_bg"
                        android:padding="5dp"
                        android:layout_margin="1dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FPS TARGET"
                            android:textColor="#80FFFFFF"
                            android:textSize="@dimen/_6ssp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/drawer_perf_fps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="60.0 FPS"
                            android:textColor="#00FFCC"
                            android:textSize="@dimen/_8ssp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Metric: CPU -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/premium_edit_bg"
                        android:padding="5dp"
                        android:layout_margin="1dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CORE CHIPSET"
                            android:textColor="#80FFFFFF"
                            android:textSize="@dimen/_6ssp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/drawer_perf_cpu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="OCTA-CORE"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_8ssp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Metric: GPU -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/premium_edit_bg"
                        android:padding="5dp"
                        android:layout_margin="1dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GRAPHICS CORE"
                            android:textColor="#80FFFFFF"
                            android:textSize="@dimen/_6ssp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/drawer_perf_gpu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ADRENO GPU"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_8ssp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Metric: RAM Allocation -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/premium_edit_bg"
                        android:padding="5dp"
                        android:layout_margin="1dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ALLOCATED RAM"
                            android:textColor="#80FFFFFF"
                            android:textSize="@dimen/_6ssp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/drawer_perf_ram"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1144 MB"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_8ssp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Metric: JVM Heap Memory -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/premium_edit_bg"
                        android:padding="5dp"
                        android:layout_margin="1dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FREE SYSTEM MEMORY"
                            android:textColor="#80FFFFFF"
                            android:textSize="@dimen/_6ssp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/drawer_perf_memory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.2 GB"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_8ssp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Metric: Active Renderer -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/premium_edit_bg"
                        android:padding="5dp"
                        android:layout_margin="1dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE RENDERER"
                            android:textColor="#80FFFFFF"
                            android:textSize="@dimen/_6ssp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/drawer_perf_renderer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="HOLY GL4ES"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_8ssp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textStyle="bold" />
                    </LinearLayout>
                </GridLayout>

                <!-- SECTION 1: OPERATIONS & TELEMETRY -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• OPERATIONS &amp; DIAGNOSTICS"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_logs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="EXPORT LOGS"
                    android:drawableStart="@drawable/ic_px_sharelog"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_downloads_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="BACKGROUND DOWNLOADS"
                    android:drawableStart="@drawable/ic_px_file_dl"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_news_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="LATEST NEWS"
                    android:drawableStart="@drawable/ic_px_book"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="12dp" />

                <!-- SECTION 2: INSTALLED ADDONS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• INSTALLED MODULES"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_mods_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="INSTALLED MODS"
                    android:drawableStart="@drawable/ic_px_zap"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_resource_packs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="RESOURCE PACKS"
                    android:drawableStart="@drawable/ic_px_image"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_shader_packs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="SHADER PACKS"
                    android:drawableStart="@drawable/ic_px_image_renderer"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="12dp" />

                <!-- SECTION 3: SYSTEM CONTROLS & DEVELOPMENT -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• DEV &amp; COMMAND EXPERIMENT"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_controls_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="DEVELOPER OPTIONS"
                    android:drawableStart="@drawable/ic_px_gamepad"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_settings_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="EXPERIMENTAL STUFF"
                    android:drawableStart="@drawable/ic_px_sliders"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="16dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/tray_close"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="COLLAPSE TERMINAL"
                    android:textColor="#000000"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_button_bg" />
            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
