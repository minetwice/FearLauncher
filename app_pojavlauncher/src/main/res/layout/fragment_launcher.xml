<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fear_ambient_bg">

    <!-- Unified Dynamic Red Particle Animation Layer (GPU-friendly) -->
    <com.kdt.mcgui.GlassParticleView
        android:id="@+id/glass_particle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25" />

    <!-- ZONE A: LEFT SIDEBAR NAVIGATION (Width can expand smoothly, collapsed: 72dp, expanded: 230dp) -->
    <LinearLayout
        android:id="@+id/left_nav"
        android:layout_width="230dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/fear_left_sidebar_bg"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Top Sidebar Logo Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_app_logo"
                app:tint="@color/red_primary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FEAR"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <!-- Red glow underline element -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAUNCHER"
                    android:textColor="@color/red_hover"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.22" />
            </LinearLayout>
        </LinearLayout>

        <!-- Underline Glow bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@drawable/character_pedestal_shadow"
            android:layout_marginBottom="20dp" />

        <!-- Sidebar Navigation Options -->
        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/tab_home"
            style="@style/FearLeftNavButton.Selected"
            android:text="Home"
            android:drawableStart="@drawable/ic_px_home"
            android:layout_marginBottom="8dp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/tab_installations"
            style="@style/FearLeftNavButton"
            android:text="Play / Instances"
            android:drawableStart="@drawable/ic_px_file"
            android:layout_marginBottom="8dp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/tab_skin"
            style="@style/FearLeftNavButton"
            android:text="Skins"
            android:drawableStart="@drawable/ic_px_image"
            android:layout_marginBottom="8dp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/tab_mods"
            style="@style/FearLeftNavButton"
            android:text="Mods"
            android:drawableStart="@drawable/ic_px_zap"
            android:layout_marginBottom="8dp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/tab_servers"
            style="@style/FearLeftNavButton"
            android:text="Servers"
            android:drawableStart="@drawable/ic_px_book"
            android:layout_marginBottom="8dp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/tab_news"
            style="@style/FearLeftNavButton"
            android:text="News"
            android:drawableStart="@drawable/ic_px_sharelog"
            android:layout_marginBottom="8dp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/tab_settings_icon"
            style="@style/FearLeftNavButton"
            android:text="Settings"
            android:drawableStart="@drawable/ic_px_sliders"
            android:layout_marginBottom="8dp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- User Profile Chip at bottom of sidebar (Avatar + Username) -->
        <LinearLayout
            android:id="@+id/account_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/fear_card_accent_bg">

            <androidx.cardview.widget.CardView
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/red_glow"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/account_button_sidebar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_account_circle"
                    android:padding="2dp"
                    app:tint="@color/text_primary" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/account_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guest"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/account_type_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free / Offline"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settings_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_sharp_settings_24"
                android:padding="2dp"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="● FearLauncher v3.0"
            android:textColor="@color/text_muted"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- ZONE B & C: CONTAINER FOR THE MAIN WORKSPACE -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@id/left_nav"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TOP CUSTOM WINDOW TITLE / STATUS BAR -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="@color/top_bar_bg"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Welcome message with Red highlight -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to the next generation of launcher,"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/account_name_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GUEST PLAYER"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="4" />
            </LinearLayout>

            <TextView
                android:layout_width="120dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/fear_glass_chip_bg"
                android:text="●  Online"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/account_button"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/fear_glass_chip_bg"
                android:src="@drawable/ic_account_circle"
                android:padding="8dp"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/notification_button"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/fear_glass_chip_bg"
                android:src="@drawable/ic_px_bell"
                android:padding="8dp"
                app:tint="@color/text_primary" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/hamburger_menu_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/fear_glass_chip_bg"
                android:src="@drawable/ic_three_dots"
                android:padding="8dp"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- ZONE B: CENTER MAIN WORKSPACE -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/center_main_workspace"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/right_preview_panel">

            <!-- Hero Section Card (Glassmorphic Red Accent Panel) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/hero_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/fear_glass_panel_bg"
                android:padding="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/feature_cards_row"
                app:layout_constraintVertical_weight="3">

                <ImageView
                    android:id="@+id/hero_art"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_mojo_full"
                    android:alpha="0.85"
                    android:scaleType="centerInside"
                    app:layout_constraintWidth_percent="0.4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toEndOf="@id/hero_art"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE INSTANCE"
                        android:textColor="@color/red_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/version_text_display"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1.21.1"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/edit_profile_button_main"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/fear_glass_chip_bg"
                            android:src="@drawable/ic_px_edit"
                            android:padding="8dp"
                            app:tint="@color/text_primary" />
                    </LinearLayout>

                    <!-- mcVersionSpinner (Custom Styled Version Selector with Red Highlights) -->
                    <com.kdt.mcgui.mcVersionSpinner
                        android:id="@+id/mc_version_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/fear_glass_chip_bg" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="⚒  Fabric Loader / Forge Installer\n⇩  Java Runtime Environment Optimized\n▣  Red Glow Interactive Engine Activated"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp" />

                    <!-- CTA Play Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Large gradient RED play button (Primary CTA) -->
                        <com.kdt.mcgui.MineButton
                            android:id="@+id/play_button"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:background="@drawable/fear_play_button_bg"
                            android:text="PLAY NOW"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="2"
                            android:shadowRadius="8" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Feature Cards Row (News, Latest Version, Server Status) with hover Lift -->
            <LinearLayout
                android:id="@+id/feature_cards_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/hero_card"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_weight="1">

                <!-- News Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/fear_card_accent_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NEWS &amp; UPDATES"
                        android:textColor="@color/red_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minecraft 1.21.1 and snapshot integrations are ready for play."
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Latest Version Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/fear_card_accent_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LATEST RELEASE"
                        android:textColor="@color/red_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Instance profile successfully synchronized with CraftynMC database."
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Server Status Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/fear_card_accent_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SERVER STATUS"
                        android:textColor="@color/red_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CraftynMC/FEAR Server: ONLINE\n3,421 active players."
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ZONE C: RIGHT PANEL - CHARACTER PREVIEW -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/right_preview_panel"
            android:layout_width="240dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            android:padding="16dp"
            android:background="@drawable/fear_glass_panel_bg"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/preview_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHARACTER PREVIEW"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Underline glow -->
            <View
                android:id="@+id/preview_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/character_pedestal_shadow"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/preview_title" />

            <!-- Pedestal glow shadow and Character view container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintTop_toBottomOf="@id/preview_divider"
                app:layout_constraintBottom_toTopOf="@+id/preview_controls_row">

                <!-- Pedestal shadow underneath skin view -->
                <View
                    android:layout_width="160dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/character_pedestal_shadow" />

                <!-- Beautiful Rotating Player Skin View -->
                <com.kdt.mcgui.MinecraftSkinView
                    android:id="@+id/character_preview_skin_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Controls under preview: Randomize, Change, Cape -->
            <LinearLayout
                android:id="@+id/preview_controls_row"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent">

                <Button
                    android:id="@+id/btn_random_skin"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Random"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:background="@drawable/fear_glass_chip_bg"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_change_skin"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Change"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:background="@drawable/fear_glass_chip_bg"
                    android:layout_marginEnd="4dp" />

                <ImageButton
                    android:id="@+id/btn_cape_skin"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_px_zap"
                    android:background="@drawable/fear_glass_chip_bg"
                    android:padding="8dp"
                    app:tint="@color/text_primary" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- UI Logic Dummies to preserve exact Java references & callbacks -->
    <TextView android:id="@+id/version_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/edit_profile_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/settings_tray" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
