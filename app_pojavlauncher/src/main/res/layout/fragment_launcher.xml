<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg">

    <!-- Floating Particles Layer -->
    <com.kdt.mcgui.GlassParticleView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3" />

    <!-- Top Header Bar (Step 6 Alignment Requirements Redesigned with Hamburger on Left) -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_12sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top Left: Hamburger, Logo & Launcher Name -->
        <ImageButton
            android:id="@+id/hamburger_menu_icon"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:src="@drawable/ic_hamburger"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            android:layout_marginEnd="@dimen/_10sdp" />

        <ImageView
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:src="@drawable/ic_app_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="FEAR LAUNCHER"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginStart="@dimen/_8sdp" />

        <!-- Top Right: Avatar, Notification -->
        <androidx.cardview.widget.CardView
            android:id="@+id/header_avatar_card"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            app:cardCornerRadius="@dimen/_12sdp"
            app:cardBackgroundColor="#20FFFFFF"
            app:cardElevation="0dp"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:layout_marginEnd="@dimen/_10sdp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_account_circle"
                android:padding="0dp" />
        </androidx.cardview.widget.CardView>

        <ImageButton
            android:id="@+id/header_notification_btn"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:src="@drawable/ic_px_bell"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <!-- Main Content Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Center Card (Step 8 Layout and spacing upgrades) -->
        <LinearLayout
            android:layout_width="@dimen/_280sdp"
            android:layout_height="wrap_content"
            android:background="@drawable/premium_glass_black_bg"
            android:orientation="vertical"
            android:padding="@dimen/_18sdp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Dynamic 2D Skin Head Preview -->
            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                app:cardCornerRadius="@dimen/_22sdp"
                app:cardBackgroundColor="#20FFFFFF"
                app:cardElevation="0dp"
                android:layout_marginBottom="@dimen/_8sdp">
                <ImageView
                    android:id="@+id/homepage_skin_head"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />
            </androidx.cardview.widget.CardView>

            <!-- Subcard Header details -->
            <TextView
                android:id="@+id/account_name_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guest"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/version_text_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.21.1"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_10ssp"
                android:layout_marginTop="2dp" />

            <!-- Core System Info / Runtime and Loader -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/card_runtime_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JVM: INTERNAL"
                    android:textColor="#00FFCC"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="#2000FFCC"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/card_loader_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOADER: AUTO"
                    android:textColor="#00F0FF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="#2000F0FF"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <!-- Spacing and divider line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AFFFFFF"
                android:layout_marginBottom="16dp" />

            <!-- Selector and Edit / Settings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <com.kdt.mcgui.mcVersionSpinner
                    android:id="@+id/mc_version_spinner"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/premium_glass_black_bg" />

                <ImageButton
                    android:id="@+id/edit_profile_button_main"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_px_edit"
                    android:background="@drawable/premium_glass_black_bg"
                    android:padding="10dp"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/settings_button_main"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_sharp_settings_24"
                    android:background="@drawable/premium_glass_black_bg"
                    android:padding="10dp"
                    app:tint="#FFFFFF" />
            </LinearLayout>

            <!-- Hero PLAY Button (Blue Gradient Neon Glow - Step 9) -->
            <com.kdt.mcgui.MineButton
                android:id="@+id/play_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:text="PLAY"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:background="@drawable/premium_play_button_bg"
                android:elevation="8dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- UI Logic Dummies -->
    <TextView android:id="@+id/account_name" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/account_type_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/version_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/account_section" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/edit_profile_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_home" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_installations" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_skin" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_settings_icon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <!-- ULTRA-PROFESSIONAL GLASS SIDEBAR TRAY (Slides from Left - Step 7 Redesign) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settings_tray"
        android:layout_width="@dimen/_280sdp"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:cardBackgroundColor="#F2000000"
        app:cardCornerRadius="0dp"
        app:cardElevation="32dp"
        app:layout_constraintStart_toStartOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tray_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_16sdp"
                android:background="@drawable/premium_glass_black_bg">

                <!-- Premium Header Profile Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/premium_edit_bg"
                    android:padding="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#20FFFFFF"
                        app:cardElevation="2dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_app_logo"
                            android:scaleType="centerCrop"
                            android:padding="6dp" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="COMMAND CORE"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SYSTEMS ONLINE"
                            android:textColor="#00FFCC"
                            android:textSize="@dimen/_7ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 1: OPERATIONS & TELEMETRY -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• OPERATIONS &amp; DIAGNOSTICS"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_logs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="EXPORT LOGS"
                    android:drawableStart="@drawable/ic_px_sharelog"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_downloads_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="BACKGROUND DOWNLOADS"
                    android:drawableStart="@drawable/ic_px_file_dl"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_news_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="LATEST NEWS"
                    android:drawableStart="@drawable/ic_px_book"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="12dp" />

                <!-- SECTION 2: INSTALLED ADDONS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• INSTALLED MODULES"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_mods_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="INSTALLED MODS"
                    android:drawableStart="@drawable/ic_px_zap"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_resource_packs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="RESOURCE PACKS"
                    android:drawableStart="@drawable/ic_px_image"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_shader_packs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="SHADER PACKS"
                    android:drawableStart="@drawable/ic_px_image_renderer"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_skin_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="SKIN CUSTOMIZER"
                    android:drawableStart="@drawable/ic_account_circle"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="12dp" />

                <!-- SECTION 3: SYSTEM CONTROLS & DEVELOPMENT -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• DEV &amp; COMMAND EXPERIMENT"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_controls_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="DEVELOPER OPTIONS"
                    android:drawableStart="@drawable/ic_px_gamepad"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="6dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_settings_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="EXPERIMENTAL STUFF"
                    android:drawableStart="@drawable/ic_px_sliders"
                    android:background="@drawable/tray_button_bg"
                    android:layout_marginBottom="16dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/tray_close"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="COLLAPSE TERMINAL"
                    android:textColor="#000000"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_button_bg" />
            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>