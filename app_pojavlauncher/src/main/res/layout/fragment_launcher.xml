<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg">

    <!-- Header with right Hamburger -->
    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_16sdp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FEAR LAUNCHER"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_centerVertical="true" />

        <ImageButton
            android:id="@+id/hamburger_menu_icon"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:src="@drawable/ic_hamburger"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- Main Content Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/app_logo"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_100sdp"
            android:src="@mipmap/ic_launcher_foreground"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/_40sdp" />

        <!-- Profile / Version Display (Glass Box) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_24sdp"
            android:paddingVertical="@dimen/_12sdp"
            android:background="@drawable/premium_glass_bg"
            app:layout_constraintTop_toBottomOf="@id/app_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/_24sdp">

            <TextView
                android:id="@+id/account_name_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GUEST"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/version_text_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.21.1"
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>

        <!-- Bottom Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="@dimen/_40sdp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="@dimen/_220sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/premium_glass_bg" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/play_button"
                android:layout_width="@dimen/_200sdp"
                android:layout_height="@dimen/_54sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="PLAY"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold"
                android:background="@drawable/premium_button_bg" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- UI Logic Dummies (Preserved for Fragment functionality) -->
    <TextView android:id="@+id/account_name" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/account_type_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/version_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/account_section" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <ImageButton android:id="@+id/edit_profile_button_main" android:layout_width="40dp" android:layout_height="40dp" android:visibility="gone" />
    <View android:id="@+id/edit_profile_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_home" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_installations" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_skin" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/tab_settings_icon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <!-- GLASS SIDEBAR TRAY (Right Side Slide) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settings_tray"
        android:layout_width="@dimen/_240sdp"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        app:cardElevation="32dp"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/_20sdp"
            android:background="@drawable/premium_glass_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAVIGATION"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_marginBottom="@dimen/_24sdp" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/tray_settings_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:text="SETTING"
                android:drawableStart="@drawable/ic_px_sliders"
                android:background="@drawable/premium_button_bg"
                android:layout_marginBottom="8dp" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/tray_execute_jar_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:text="EXECUTE JAR"
                android:drawableStart="@drawable/ic_px_java_run"
                android:background="@drawable/premium_button_bg"
                android:layout_marginBottom="8dp" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/tray_skin_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:text="SKIN"
                android:drawableStart="@drawable/ic_account_circle"
                android:background="@drawable/premium_button_bg"
                android:layout_marginBottom="8dp" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/tray_account_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:text="ACCOUNT"
                android:drawableStart="@drawable/ic_px_edit"
                android:background="@drawable/premium_button_bg"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#40FFFFFF" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/more_settings_toggle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:text="ADVANCED"
                android:drawableStart="@drawable/ic_px_alt_sliders"
                android:background="@drawable/premium_button_bg" />

            <!-- Sub Tray for More Settings -->
            <LinearLayout
                android:id="@+id/more_settings_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                android:paddingStart="16dp">

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_controls_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="CUSTOM CONTROLS"
                    android:background="@drawable/premium_button_bg"
                    android:layout_marginBottom="4dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_mods_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="MODS"
                    android:background="@drawable/premium_button_bg"
                    android:layout_marginBottom="4dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_logs_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="SHARE LOGS"
                    android:background="@drawable/premium_button_bg"
                    android:layout_marginBottom="4dp" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/tray_open_dir_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:text="OPEN DIRECTORY"
                    android:background="@drawable/premium_button_bg" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tray_close"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:text="DISMISS"
                android:background="@drawable/premium_button_bg" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
