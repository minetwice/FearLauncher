<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR UI v12: clean download dashboard - black glass sheet, crimson progress -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- status chip (hidden by default - dashboard opens from sidebar) -->
    <LinearLayout
        android:id="@+id/progress_bar_status_root"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/download_float_chip"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_6sdp">

        <ProgressBar
            android:id="@+id/progress_generic_progressbar"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp" />

        <TextView
            android:id="@+id/progress_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_8ssp" />

        <TextView
            android:id="@+id/progress_expand_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIEW DASHBOARD"
            android:textColor="#4DFFFFFF"
            android:textSize="@dimen/_8ssp" />
    </LinearLayout>

    <!-- DOWNLOAD DASHBOARD - full glass sheet -->
    <FrameLayout
        android:id="@+id/download_dashboard_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#D9000208">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_16sdp"
            android:orientation="vertical"
            android:background="@drawable/premium_glass_black_bg"
            android:padding="@dimen/_16sdp">

            <!-- header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dash_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DOWNLOADS"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_16ssp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/dash_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE TASKS"
                        android:textColor="#DC143C"
                        android:textSize="@dimen/_8ssp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_close_dashboard"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="@dimen/_34sdp"
                    android:src="@drawable/ic_px_trash"
                    android:background="@drawable/home_icon_chip_bg"
                    android:padding="@dimen/_8sdp"
                    app:tint="#FF4D6D"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- global progress -->
            <com.kdt.mcgui.TextProgressBar
                android:id="@+id/dash_global_progress"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginTop="@dimen/_10sdp" />

            <!-- task list -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/_10sdp"
                android:scrollbars="none"
                android:fadeScrollbars="true">

                <LinearLayout
                    android:id="@+id/progress_linear_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <!-- footer totals -->
            <LinearLayout
                android:id="@+id/dash_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/home_icon_chip_bg"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_8sdp">

                <TextView
                    android:id="@+id/total_speed_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp" />

                <TextView
                    android:id="@+id/total_remaining_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp" />

                <TextView
                    android:id="@+id/total_synced_data"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="#FF4D6D"
                    android:textSize="@dimen/_8ssp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</merge>
