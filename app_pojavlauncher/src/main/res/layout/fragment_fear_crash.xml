<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR crash board: what went wrong, and a way past it -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/theme_bg"
    android:padding="@dimen/_12sdp">

    <LinearLayout
        android:id="@+id/crash_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/fear_panel_bg"
        android:padding="@dimen/_14sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="4dp"
                android:layout_height="@dimen/_26sdp"
                android:background="@drawable/fear_accent_stripe" />

            <TextView
                android:id="@+id/crash_heading"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="LAUNCH FAILED"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="@dimen/_10sdp" />
        </LinearLayout>

        <TextView
            android:id="@+id/crash_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/_10sdp" />

        <TextView
            android:id="@+id/crash_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="@dimen/_9ssp"
            android:fontFamily="monospace"
            android:maxLines="6"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/_6sdp" />

        <LinearLayout
            android:id="@+id/crash_mod_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/fear_tray_row_bg"
            android:padding="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:visibility="gone">

            <TextView
                android:id="@+id/crash_mod_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="middle" />

            <com.kdt.mcgui.FearToggle
                android:id="@+id/crash_mod_toggle"
                android:layout_width="@dimen/_46sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginStart="@dimen/_10sdp" />
        </LinearLayout>

        <com.kdt.mcgui.MineButton
            android:id="@+id/crash_disable_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:text="TURN IT OFF AND LAUNCH AGAIN"
            android:textColor="#000000"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:background="@drawable/theme_button_bg"
            android:layout_marginTop="@dimen/_12sdp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/crash_switch_renderer_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:text="RUN ON MESA INSTEAD"
            android:textColor="#000000"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:visibility="gone"
            android:background="@drawable/theme_button_bg"
            android:layout_marginTop="@dimen/_8sdp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/crash_skip_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_38sdp"
            android:text="SKIP"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:background="@drawable/fear_tray_row_bg"
            android:layout_marginTop="@dimen/_8sdp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
