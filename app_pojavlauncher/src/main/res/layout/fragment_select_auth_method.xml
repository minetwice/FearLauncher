<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/_400sdp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/premium_glass_black_bg"
        android:padding="@dimen/_30sdp">

        <TextView
            android:id="@+id/auth_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CORE IDENTITY ACCESS"
            android:textColor="#FF9800"
            android:textSize="@dimen/_18ssp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="@dimen/_30sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/button_microsoft_authentication"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:text="MICROSOFT ACCOUNT"
            android:layout_marginTop="@dimen/_20sdp"
            app:layout_constraintTop_toBottomOf="@id/auth_title" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/button_local_authentication"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:text="LOCAL IDENTITY"
            android:layout_marginTop="@dimen/_12sdp"
            app:layout_constraintTop_toBottomOf="@id/button_microsoft_authentication" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/button_elyby_authentication"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:text="ELY.BY NETWORK"
            android:layout_marginTop="@dimen/_12sdp"
            app:layout_constraintTop_toBottomOf="@id/button_local_authentication" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
