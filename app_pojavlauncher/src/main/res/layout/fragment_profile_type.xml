<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg"
    android:padding="@dimen/_16sdp">

    <!-- Header -->
    <TextView
        android:id="@+id/title_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEPLOYMENT PROTOCOL"
        android:textColor="#FF9800"
        android:textSize="@dimen/_20ssp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select the architecture for your new instance."
        android:textColor="#B3FFFFFF"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintTop_toBottomOf="@id/title_textview"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_24sdp"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Category: Pure -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STABLE BUILDS"
                android:textColor="#FF9800"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/_12sdp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="@dimen/_24sdp">

                <com.kdt.mcgui.MineButton
                    android:id="@+id/vanilla_profile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_60sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="VANILLA"
                    android:padding="@dimen/_12sdp"
                    android:drawableStart="@drawable/ic_vanilla"
                    android:drawablePadding="12dp"
                    android:background="@drawable/premium_glass_black_bg" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/optifine_profile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_60sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="OPTIFINE"
                    android:padding="@dimen/_12sdp"
                    android:drawableStart="@drawable/ic_px_zap"
                    android:drawablePadding="12dp"
                    android:background="@drawable/premium_glass_black_bg" />
            </GridLayout>

            <!-- Category: Modded -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODIFICATION ENGINES"
                android:textColor="#FF9800"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/_12sdp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2">

                <com.kdt.mcgui.MineButton
                    android:id="@+id/modded_profile_fabric"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="FABRIC"
                    android:padding="@dimen/_12sdp"
                    android:drawableStart="@drawable/ic_fabric"
                    android:drawablePadding="12dp"
                    android:background="@drawable/premium_glass_black_bg" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/modded_profile_forge"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="FORGE"
                    android:padding="@dimen/_12sdp"
                    android:drawableStart="@drawable/ic_forge"
                    android:drawablePadding="12dp"
                    android:background="@drawable/premium_glass_black_bg" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/modded_profile_quilt"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="QUILT"
                    android:padding="@dimen/_12sdp"
                    android:drawableStart="@drawable/ic_quilt"
                    android:drawablePadding="12dp"
                    android:background="@drawable/premium_glass_black_bg" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/modded_profile_neoforge"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="NEOFORGE"
                    android:padding="@dimen/_12sdp"
                    android:drawableStart="@drawable/ic_neoforge"
                    android:drawablePadding="12dp"
                    android:background="@drawable/premium_glass_black_bg" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/modded_profile_modpack"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="MODPACKS"
                    android:padding="@dimen/_12sdp"
                    android:drawableStart="@drawable/ic_px_file_dl"
                    android:drawablePadding="12dp"
                    android:background="@drawable/premium_glass_black_bg" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/modded_profile_bta"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="BTA ENGINE"
                    android:padding="@dimen/_12sdp"
                    android:drawableStart="@drawable/ic_px_experiment"
                    android:drawablePadding="12dp"
                    android:background="@drawable/premium_glass_black_bg" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/modded_profile_legacy_fabric"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="LEGACY FABRIC"
                    android:padding="@dimen/_12sdp"
                    android:drawableStart="@drawable/ic_fabric"
                    android:drawablePadding="12dp"
                    android:background="@drawable/premium_glass_black_bg" />

            </GridLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
