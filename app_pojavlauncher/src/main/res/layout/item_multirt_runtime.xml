<?xml version="1.0" encoding="utf-8"?>
<!-- runtime manager row: the installed JRE, its full name, and its actions -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/_62sdp"
    android:paddingHorizontal="@dimen/_14sdp"
    android:paddingVertical="@dimen/_10sdp"
    android:background="@drawable/fear_tray_row_bg"
    android:layout_marginHorizontal="@dimen/_4sdp"
    android:layout_marginBottom="@dimen/_6sdp">

    <TextView
        android:id="@+id/multirt_view_java_version"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_12ssp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/multirt_view_removebtn"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Java 17" />

    <TextView
        android:id="@+id/multirt_view_java_version_full"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_9ssp"
        android:textColor="#99FFFFFF"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="@dimen/_2sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/multirt_view_setdefaultbtn"
        app:layout_constraintTop_toBottomOf="@id/multirt_view_java_version"
        tools:text="Internal 17" />

    <ImageButton
        android:id="@+id/multirt_view_removebtn"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp"
        android:background="@drawable/fear_tray_row_bg"
        android:padding="@dimen/_9sdp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_px_trash"
        android:tint="#FFFFFF"
        android:contentDescription="@null"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/multirt_view_setdefaultbtn"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_30sdp"
        android:minWidth="0dp"
        android:paddingHorizontal="@dimen/_10sdp"
        android:background="@drawable/theme_button_bg"
        android:textColor="#000000"
        android:textSize="@dimen/_8ssp"
        android:textStyle="bold"
        android:maxLines="1"
        android:text="SET DEFAULT"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/multirt_view_removebtn"
        app:layout_constraintTop_toBottomOf="@id/multirt_view_java_version"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
