<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080A10"
    android:padding="12dp">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/editor_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rec_button"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/editor_back"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/editor_title"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/editor_render"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dash_accent"
            android:paddingHorizontal="16dp"
            android:paddingVertical="7dp"
            android:text="@string/editor_render"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- preview stage -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_editor_panel">

        <VideoView
            android:id="@+id/editor_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- transport -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/editor_play"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_rec_button"
            android:padding="8dp"
            android:src="@drawable/ic_rec_play" />

        <TextView
            android:id="@+id/editor_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:text="0:00 / 0:00" />
    </LinearLayout>

    <!-- timeline -->
    <net.kdt.pojavlaunch.editor.TimelineView
        android:id="@+id/editor_timeline"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp" />

    <!-- tool tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/editor_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/editor_tool_hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_editor_tool"
        android:padding="12dp"
        android:textColor="#80FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
