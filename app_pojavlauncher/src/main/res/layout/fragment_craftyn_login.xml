<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/_520sdp"
        android:layout_height="@dimen/_280sdp"
        android:background="@drawable/premium_glass_black_bg"
        android:padding="@dimen/_18sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top Title -->
        <TextView
            android:id="@+id/login_header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CRAFTYN.MC STATION NETWORK"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Main Form Content Wrapper -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/craftyn_form_wrapper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/login_header_text"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Mode Selector Tabs (Login vs SignUp) -->
            <LinearLayout
                android:id="@+id/craftyn_tabs"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.48">

                <com.kdt.mcgui.MineButton
                    android:id="@+id/tab_craftyn_login"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="LOG IN"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_9ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_play_button_bg" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/tab_craftyn_signup"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="SIGN UP"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_9ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_glass_black_bg" />
            </LinearLayout>

            <!-- Inputs Column -->
            <LinearLayout
                android:id="@+id/login_input_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/craftyn_tabs"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.48">

                <com.kdt.mcgui.MineEditText
                    android:id="@+id/craftyn_username"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_32sdp"
                    android:background="@drawable/premium_edit_bg"
                    android:hint="Username"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#40FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:textSize="@dimen/_10ssp"
                    android:inputType="text" />

                <!-- Live Availability Indicator -->
                <TextView
                    android:id="@+id/craftyn_availability_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="4dp"
                    android:textColor="#66FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:text="Enter username to verify" />

                <com.kdt.mcgui.MineEditText
                    android:id="@+id/craftyn_password"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/premium_edit_bg"
                    android:hint="Security Key / Password"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#40FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:textSize="@dimen/_10ssp"
                    android:inputType="textPassword" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/craftyn_submit_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_marginTop="10dp"
                    android:text="EXECUTE LOG IN"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/premium_play_button_bg" />
            </LinearLayout>

            <!-- Vertical Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="@dimen/_150sdp"
                android:background="#1AFFFFFF"
                app:layout_constraintStart_toEndOf="@id/login_input_group"
                app:layout_constraintEnd_toStartOf="@+id/right_visual_container"
                app:layout_constraintTop_toTopOf="@id/login_input_group"
                app:layout_constraintBottom_toBottomOf="@id/login_input_group" />

            <!-- Right Visual Panel -->
            <LinearLayout
                android:id="@+id/right_visual_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/login_input_group"
                app:layout_constraintWidth_percent="0.45">

                <ImageView
                    android:layout_width="@dimen/_44sdp"
                    android:layout_height="@dimen/_44sdp"
                    android:src="@drawable/ic_auth_craftynmc"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CraftynMC Station v2.0"
                    android:textColor="#B3FFFFFF"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Live Sync Skin &amp; Account Portal"
                    android:textColor="#66FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:gravity="center" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Stage Progress HUD (Hidden by default, overlaying main panel during authenticate) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/craftyn_stage_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/login_header_text"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/craftyn_stage_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYNCHRONIZING STATION NETWORK"
                android:textColor="#00F0FF"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Stages Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/_32sdp"
                app:layout_constraintTop_toBottomOf="@id/craftyn_stage_title">

                <!-- Stage 1: Account -->
                <LinearLayout
                    android:id="@+id/stage_1_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/stage_1_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/premium_glass_black_bg"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/stage_1_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Account creation"
                        android:textColor="#80FFFFFF"
                        android:textSize="@dimen/_8ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Line 1 -->
                <View
                    android:id="@+id/stage_line_1"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="2.5dp"
                    android:background="#40FFFFFF"
                    android:layout_gravity="center_vertical"
                    android:layout_marginBottom="12dp" />

                <!-- Stage 2: Connectivity -->
                <LinearLayout
                    android:id="@+id/stage_2_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/stage_2_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/premium_glass_black_bg"
                        android:text="2"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/stage_2_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Connectivity"
                        android:textColor="#80FFFFFF"
                        android:textSize="@dimen/_8ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Line 2 -->
                <View
                    android:id="@+id/stage_line_2"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="2.5dp"
                    android:background="#40FFFFFF"
                    android:layout_gravity="center_vertical"
                    android:layout_marginBottom="12dp" />

                <!-- Stage 3: Done -->
                <LinearLayout
                    android:id="@+id/stage_3_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/stage_3_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/premium_glass_black_bg"
                        android:text="3"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/stage_3_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Done"
                        android:textColor="#80FFFFFF"
                        android:textSize="@dimen/_8ssp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Detailed Status message -->
            <TextView
                android:id="@+id/craftyn_status_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Initializing secure socket..."
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/_9ssp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="@dimen/_16sdp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
