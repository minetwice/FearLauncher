<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/_450sdp"
    android:layout_height="wrap_content"
    android:background="@drawable/premium_glass_black_bg"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp">

    <!-- Header Section (Premium Website Style Console Header) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="🖥️ FEAR VISUAL SYSTEM CONSOLE 🖥️"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_13ssp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Unleash high-fidelity color presets and intense full-canvas background animations"
        android:textColor="#80FFFFFF"
        android:textSize="@dimen/_8ssp"
        android:layout_marginTop="2dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp" />

    <!-- Horizontal Split-Pane Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_210sdp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- LEFT SIDE: Main Workspace Area -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="12dp">

            <!-- 1. Color Customizer Workspace Pane (Rainbow Color Wheel) -->
            <LinearLayout
                android:id="@+id/panel_color_workspace"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨 ADVANCED COLOR HUE SELECTION"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- The majestic 2D dynamic ColorWheelView -->
                <com.kdt.mcgui.ColorWheelView
                    android:id="@+id/theme_color_wheel"
                    android:layout_width="@dimen/_150sdp"
                    android:layout_height="@dimen/_150sdp"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Drag or tap to generate any custom ARGB color"
                    android:textColor="#50FFFFFF"
                    android:textSize="@dimen/_7ssp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- 2. Animation Selector Workspace Pane (15 Intense Options) -->
            <ScrollView
                android:id="@+id/panel_animation_workspace"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:scrollbarThumbVertical="@drawable/silver_scrollbar"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="6dp">

                    <!-- Intense Animations List (15 items) -->
                    <LinearLayout
                        android:id="@+id/anim_opt_0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥 1. AURA BURST (AURA BLAST)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Violent center attraction with a massive shockwave blast" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡ 2. SPEED DASH (TELEPORT STRIKE)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Afterimages, horizontal screen tear glitch lines and heavy rumble" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔮 3. ENERGY COMPRESSION (BEAM CHARGE)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Singularity vortex suck in with a directional massive laser beam" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚔️ 4. SLASH STRIKE (SWORD SLASH)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Diagonal slash marks, glowing sparks and violent delayed shockwaves" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🕸️ 5. DOMAIN BARRIER (DOMAIN EXPANSION)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rising perspective 3D dome, bass-drop, inverted gravity and spins" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌟 6. POWER UP PILLAR (SUPER SAIYAN)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shattering ground, rising debris, and a high-velocity golden aura column" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏱️ 7. ULTIMATE CHARGE (TIME-STOP &amp; BLAST)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Violent swirling vortex, full screen time freeze, and a massive blast" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🕳️ 8. BLACK HOLE (GRAVITY COLLAPSE)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Particles stretch, spaghettify, and collapse into a dense void point" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💾 9. DIGITAL DECAY (SEVERE GLITCH)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aggressive pixel corruption, screen tears, and heavy static noise shake" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_9"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☄️ 10. METEOR IMPACT (CRATER EXPLOSION)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Blazing streak crashes on ground with massive slow-motion spark rain" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⛈️ 11. LIGHTNING STORM (THUNDER STRIKE)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Erratic branching lightning lines, violent strobe, and zoom flashes" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_11"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌋 12. VOLCANIC ERUPTION (MAGMA BURST)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Explosive upward magma burst and low-frequency continuous rumble" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌪️ 13. CYCLONE FUNNEL (TORNADO VORTEX)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Violent wind field, particles sucked in funnel and collapsing bursts" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_13"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☢️ 14. NUCLEAR DOME (SHOCKWAVE PUSH)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Blinding bright white flash and a massive expanding 3D dome push" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_14"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔮 15. DIMENSIONAL COLLAPSE (SPACE WARP)" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Space bends and wraps to singularity then elastically snaps back" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

        </FrameLayout>

        <!-- RIGHT SIDE: Sidebar Selector Row (Color & Animation Tabs - Premium Website Panel - Step 3) -->
        <LinearLayout
            android:layout_width="@dimen/_110sdp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#20FFFFFF"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="ADMIN PANEL"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_select_colour"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_32sdp"
                android:text="🎨 COLOURS"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:background="@drawable/premium_button_bg" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_select_animation"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_32sdp"
                android:text="🌀 ANIMATION"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:background="@drawable/premium_button_bg" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Close Dialog in Navigation Sidebar -->
            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_close_customizer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_28sdp"
                android:text="CLOSE"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:background="@drawable/premium_button_bg" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
