                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌌 DOMAIN EXPANSION VOID" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Infinite void radial dark space orbits" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

        </FrameLayout>

        <!-- RIGHT SIDE: Sidebar Selector Row (Color & Animation Tabs - Step 3) -->
        <LinearLayout
            android:layout_width="@dimen/_110sdp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#20FFFFFF"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="NAV BAR"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_select_colour"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_32sdp"
                android:text="🎨 COLOURS"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:background="@drawable/premium_button_bg" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_select_animation"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_32sdp"
                android:text="🌀 ANIMATION"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:background="@drawable/premium_button_bg" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Close Dialog in Navigation Sidebar -->
            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_close_customizer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_28sdp"
                android:text="CLOSE"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:background="@drawable/premium_button_bg" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
