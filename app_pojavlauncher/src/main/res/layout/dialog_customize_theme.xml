<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/_450sdp"
    android:layout_height="wrap_content"
    android:background="@drawable/premium_glass_black_bg"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp">

    <!-- Header Section (Premium Website Style Console Header) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="🖥️ FEAR VISUAL SYSTEM CONSOLE 🖥️"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_13ssp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Unleash high-fidelity color presets and intense full-canvas background animations"
        android:textColor="#80FFFFFF"
        android:textSize="@dimen/_8ssp"
        android:layout_marginTop="2dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp" />

    <!-- Horizontal Split-Pane Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_210sdp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- LEFT SIDE: Main Workspace Area -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="12dp">

            <!-- 1. Color Customizer Workspace Pane (Rainbow Color Wheel) -->
            <LinearLayout
                android:id="@+id/panel_color_workspace"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨 ADVANCED COLOR HUE SELECTION"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- The majestic 2D dynamic ColorWheelView -->
                <com.kdt.mcgui.ColorWheelView
                    android:id="@+id/theme_color_wheel"
                    android:layout_width="@dimen/_150sdp"
                    android:layout_height="@dimen/_150sdp"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Drag or tap to generate any custom ARGB color"
                    android:textColor="#50FFFFFF"
                    android:textSize="@dimen/_7ssp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- 2. Animation Selector Workspace Pane (15 Intense Options) -->
            <ScrollView
                android:id="@+id/panel_animation_workspace"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:scrollbarThumbVertical="@drawable/silver_scrollbar"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="6dp">

                    <!-- Intense Animations List (15 items) -->
                    <LinearLayout
                        android:id="@+id/anim_opt_0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥 1. SUPREME AURA EXPLOSION" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spherical aura releases power waves and rising energy columns" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌀 2. RASENGAN SPIRAL SPHERE" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Swirling chakra energy with opposite rotating outer rings" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡ 3. CHIDORI LIGHTNING CLAW" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chirping electric discharges and intense lightning arcs" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔮 4. SPIRIT BOMB GATHERING" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Light particles merge into a colossal sphere at the top" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚔️ 5. BANKAI SLASH ERUPTION" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sharp vertical sword slash with drifting glass shatter shapes" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💥 6. KAMEHAMEHA CHARGE-UP" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Opposite ends energy waves merge into a giant laser beam" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🐉 7. DRAGON'S FURY VORTEX" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spiral dragon energy columns swirling upwards" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🕳️ 8. VOID IMPLOSION" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Central black void spot sucking and collapsing space" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌀 9. FRACTAL SPIRAL BURST" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Complex expanding branches growing like an infinite mandala" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_9"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏱️ 10. TEMPORAL REWIND RING" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reverse spinning clock hand and backward flying gears" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⛈️ 11. VOLTAIC STORM GRID" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Horizontal and vertical electric wire grids with violent lightning" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_11"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔮 12. GRAVITY DISTORTION LENS" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Invisible gravity sphere bending and curving space light rays" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💎 13. PRISMATIC SHATTER" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spinning geometric crystal shatters and merges back" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_13"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌌 14. NEBULA SWIRL" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Colorful cosmic dust clouds mixing with twinkling stars" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/anim_opt_14"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:background="@drawable/premium_edit_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🩸 15. PLASMA ERUPTION" android:textColor="#FFFFFF" android:textSize="@dimen/_8ssp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hot loop-shaped plasma arcs rising and bursting into flame rings" android:textColor="#80FFFFFF" android:textSize="@dimen/_6ssp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

        </FrameLayout>

        <!-- RIGHT SIDE: Sidebar Selector Row (Color & Animation Tabs - Premium Website Panel - Step 3) -->
        <LinearLayout
            android:layout_width="@dimen/_110sdp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#20FFFFFF"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="ADMIN PANEL"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_select_colour"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_32sdp"
                android:text="🎨 COLOURS"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:background="@drawable/premium_button_bg" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/tab_select_animation"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_32sdp"
                android:text="🌀 ANIMATION"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:background="@drawable/premium_button_bg" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Close Dialog in Navigation Sidebar -->
            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_close_customizer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_28sdp"
                android:text="CLOSE"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:background="@drawable/premium_button_bg" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
