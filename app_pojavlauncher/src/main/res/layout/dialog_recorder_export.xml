<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR EXPORT STUDIO â€” re-master recordings (4K upscale, fps smooth, audio tools) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg"
    android:padding="12dp">

    <!-- Top Action Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rec_export_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXPORT STUDIO"
            android:textColor="#FF003C"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/rec_export_close"
            android:layout_width="100dp"
            android:layout_height="36dp"
            android:text="COLLAPSE"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold"
            android:background="@drawable/premium_button_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/rec_export_header_divider"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#FF003C"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/rec_export_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/rec_export_header_divider"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- ============ VIDEO UPSCALE ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="â€¢ VIDEO QUALITY UPSCALE"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.kdt.mcgui.MineButton
                    android:id="@+id/rec_res_same"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="SAME"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_button_bg"
                    android:layout_marginEnd="4dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/rec_res_1080"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="1080P"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/rec_res_1440"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="1440P"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/rec_res_4k"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="4K"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upscale re-encodes the video on the GPU â€” up to 4K."
                android:textColor="#59FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:layout_marginTop="4dp"
                androoid:layout_marginBottom="10dp" />

            <!-- ============== SMOOTHNESS ============= -->
            <TextView
                 android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="â€¢ SMOOTHENES (CONSTANT FPS)"
                android:textColor="#80FFFFFF"
                 android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.kdt.mcgui.MineButton
                    android:id="@+id/rec_fps_same"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="SAME"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_button_bg"
                    android:layout_marginEnd="4dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/rec_fps_30"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="30 FPS"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/rec_fps_60"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="60 FPS"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Laggy recordings look janky because of uneven frame timing. Re-timing to constant 30/60 FPS fixes the judder."
                android:textColor="#59FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp" />

            <!-- ============= AUDIO ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="â€¢ AUDIO SOURCES &amp; CLEANUP"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

