<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/login_card"
        android:layout_width="@dimen/_520sdp"
        android:layout_height="@dimen/_280sdp"
        android:background="@drawable/premium_glass_black_bg"
        android:padding="@dimen/_24sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Close Button (Back Arrow) -->
        <ImageButton
            android:id="@+id/btn_close_add_account"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:src="@drawable/ic_px_arrow_left"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Header -->
        <TextView
            android:id="@+id/login_header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_40sdp"
            android:text="ACCOUNT ACCESS"
            android:textColor="#FF9800"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Left Side: Login Form (Atom Style) -->
        <LinearLayout
            android:id="@+id/login_input_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/_32sdp"
            app:layout_constraintTop_toBottomOf="@id/login_header_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.45">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FEAR LAUNCHER"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_20ssp"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/_16sdp" />

            <com.kdt.mcgui.MineEditText
                android:id="@+id/local_username_input"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_36sdp"
                android:background="@drawable/premium_edit_bg"
                android:hint="Username / Email"
                android:textColor="#FFFFFF"
                android:textColorHint="#40FFFFFF"
                android:paddingHorizontal="16dp"
                android:textSize="@dimen/_11ssp" />

            <TextView
                android:id="@+id/local_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF5252"
                android:textSize="@dimen/_9ssp"
                android:visibility="gone"
                android:layout_marginTop="4dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="Sign in"
                android:textColor="#FFFFFF"
                android:background="@drawable/premium_button_bg" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_12sdp">

                <CheckBox
                    android:id="@+id/save_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save"
                    android:textColor="#B3FFFFFF"
                    android:textSize="@dimen/_9ssp"
                    android:buttonTint="#FF9800"
                    android:paddingEnd="12dp" />

                <CheckBox
                    android:id="@+id/auto_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Login"
                    android:textColor="#B3FFFFFF"
                    android:textSize="@dimen/_9ssp"
                    android:buttonTint="#FF9800" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="@dimen/_160sdp"
            android:background="#1AFFFFFF"
            app:layout_constraintStart_toEndOf="@id/login_input_group"
            app:layout_constraintEnd_toStartOf="@+id/right_visual_container"
            app:layout_constraintTop_toTopOf="@id/login_input_group"
            app:layout_constraintBottom_toBottomOf="@id/login_input_group" />

        <!-- Right Side: Graphic and Auth Mode Selection -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/right_visual_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_20sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/login_input_group"
            app:layout_constraintWidth_percent="0.45">

            <ImageView
                android:id="@+id/login_logo_visual"
                android:layout_width="@dimen/_120sdp"
                android:layout_height="@dimen/_120sdp"
                android:src="@mipmap/ic_launcher_foreground"
                android:alpha="0.8"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <RadioButton
                    android:id="@+id/radio_local"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Local Auth"
                    android:checked="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="@dimen/_9ssp"
                    android:buttonTint="#FF9800" />

                <RadioButton
                    android:id="@+id/radio_microsoft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Microsoft Auth"
                    android:textColor="#B3FFFFFF"
                    android:textSize="@dimen/_9ssp"
                    android:buttonTint="#FF9800" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
