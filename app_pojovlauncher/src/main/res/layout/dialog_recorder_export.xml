<?xml version="1.0" encoding="utf-8"?>
<!-- FEAR EXPORT STUDIO — re-master recordings (4K upscale, fps smooth, audio tools) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_bg"
    android:padding="12dp">

    <!-- Top Action Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rec_export_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXPORT STUDIO"
            android:textColor="#FF003C"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/rec_export_hide"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/rec_ic_eye"
            android:background="@drawable/premium_glass_black_bg"
            android:layout_marginEnd="6dp"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/rec_export_close" />

        <net.kdt.pojavlauncher.recorder.SmallButton
            android:id="@+id/rec_export_close"
            android:layout_width="84dp"
            android:layout_height="36dp"
            android:text="COLLAPSE"
            android:padding="2dp"
            android:textColor="#FFFFFF"
            android:background="@drawable/premium_button_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/rec_export_header_divider"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#FF003C"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/rec_export_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/rec_export_header_divider"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- ============ VIDEO UPSCALE ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VIDEO QUALITY UPSCALE"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <net.kdt.pojavlauncher.recorder.SmallButton
                    android:id="@+id/rec_res_same"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="SAME"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_button_bg"
                    android:layout_marginEnd="4dp" />

                <net.kdt.pojavlauncher.recorder.SmallButton
                    android:id="@+id/rec_res_1080"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="1080P"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <net.kdt.pojavlauncher.recorder.SmallButton
                    android:id="@+id/rec_res_1440"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="1440P"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <net.kdt.pojavlauncher.recorder.SmallButton
                    android:id="@+id/rec_res_4k"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="4K"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upscale re-encodes the video on the GPU — up to 4K."
                android:textColor="#59FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp" />

            <!-- ============ SMOOTHNESS ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SMOOTHNESS (CONSTANT FPS)"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <net.kdt.pojavlauncher.recorder.SmallButton
                    android:id="@+id/rec_fps_same"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="SAME"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_button_bg"
                    android:layout_marginEnd="4dp" />

                <net.kdt.pojavlauncher.recorder.SmallButton
                    android:id="@+id/rec_fps_30"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="30 FPS"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <net.kdt.pojavlauncher.recorder.SmallButton
                    android:id="@+id/rec_fps_60"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="60 FPS"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Laggy recordings look janky because of uneven frame timing. Re-timing to constant 30/60 FPS fixes the judder."
                android:textColor="#59FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp" />

            <!-- ============ AUDIO ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AUDIO SOURCES + CLEANUP"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <net.kdt.pojavlauncher.recorder.SmallButton
                    android:id="@+id/rec_audio_both"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="BOTH"
                    android:drawableStart="@drawable/rec_ic_both"
                    android:drawablePadding="4dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:padding="2dp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/premium_button_bg"
                    android:layout_marginEnd="4dp" />

                <net.kdt.pojavlauncher.recorder.SmallButton
                    android:id="@+id/rec_audio_miconly"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="MIC ONLY"
                    android:drawableStart="@drawable/rec_ic_mic"
                    android:drawablePadding="4dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:padding="2dp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <net.kdt.pojavlauncher.recorder.SmallButton
                    android:id="@+id/rec_audio_deviceonly"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="DEVICE ONLY"
                    android:drawableStart="@drawable/rec_ic_device"
                    android:drawablePadding="4dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:padding="2dp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <net.kdt.pojavlauncher.recorder.SmallButton
                    android:id="@+id/rec_audio_nr"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="NOISE CUT"
                    android:drawableStart="@drawable/rec_ic_nr"
                    android:drawablePadding="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginEnd="6dp" />

                <net.kdt.pojavlauncher.recorder.SmallButton
                    android:id="@+id/rec_audio_boost"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="VOICE BOOST"
                    android:drawableStart="@drawable/rec_ic_boost"
                    android:drawablePadding="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap DEVICE/MIC to mute that source. Noise Cut removes hiss + rumble, Voice Boost lifts commentary."
                android:textColor="#59FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp" />

            <!-- ============ SAVE TO ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SAVE TO"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <net.kdt.pojavlauncher.recorder.SmallButton
                    android:id="@+id/rec_dest_downloads"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="DOWNLOADS"
                    android:drawableStart="@drawable/rec_ic_download"
                    android:drawablePadding="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_button_bg"
                    android:layout_marginEnd="6dp" />

                <net.kdt.pojavlauncher.recorder.SmallButton
                    android:id="@+id/rec_dest_pick"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="PICK FOLDER"
                    android:drawableStart="@drawable/rec_ic_folder"
                    android:drawablePadding="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:background="@drawable/premium_glass_black_bg"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Downloads saves to Download/FearLauncher. Pick Folder lets you choose any directory and file name."
                android:textColor="#59FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/rec_export_spinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminateTint="#FF003C" />

                <ProgressBar
                    android:id="@+id/rec_export_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:max="100"
                    android:progressTint="#FF003C" />
            </LinearLayout>

            <TextView
                android:id="@+id/rec_export_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready to export"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/_7ssp"
                android:layout_marginTop="4dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/rec_export_btn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="EXPORT VIDEO"
                android:drawableStart="@drawable/rec_ic_export"
                android:drawablePadding="6dp"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:background="@drawable/premium_red_button_bg"
                android:layout_marginTop="12dp" />

            <net.kdt.pojavlauncher.recorder.SmallButton
                android:id="@+id/rec_export_cancel"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:text="CANCEL"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:background="@drawable/premium_glass_black_bg"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
